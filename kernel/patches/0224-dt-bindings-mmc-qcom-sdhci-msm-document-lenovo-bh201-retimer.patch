From 93dd2f230d9561c4a8060356fe7c99b43aead166 Mon Sep 17 00:00:00 2001
From: li-yiyang <yiyang.li.11pro@outlook.com>
Date: Mon, 23 Nov 2026 11:20:52 +0800
Subject: [PATCH 1/4] dt-bindings: mmc: qcom,sdhci-msm: document
 lenovo,bh201-retimer

The microSD slot on the Lenovo Y700 (TB323FU) has an O2Micro/BayHub BH201
retimer between the SDHCI controller and the card.  Its 200 MHz TX DLL
phase is specific to the card and to the power-up, so the host driver has
to calibrate it before SDR104 is used.  Document the board property that
selects that calibration; the retimer table in the driver is the board's.

Signed-off-by: li-yiyang <yiyang.li.11pro@outlook.com>
---
 Documentation/devicetree/bindings/mmc/qcom,sdhci-msm.yaml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/Documentation/devicetree/bindings/mmc/qcom,sdhci-msm.yaml b/Documentation/devicetree/bindings/mmc/qcom,sdhci-msm.yaml
index b3fcc1673..a12c7c061 100644
--- a/Documentation/devicetree/bindings/mmc/qcom,sdhci-msm.yaml
+++ b/Documentation/devicetree/bindings/mmc/qcom,sdhci-msm.yaml
@@ -137,6 +137,14 @@ properties:
   resets:
     maxItems: 1
 
+  lenovo,bh201-retimer:
+    type: boolean
+    description:
+      The SD slot has an O2Micro/BayHub BH201 SD retimer between the
+      controller and the card.  Its 200 MHz TX DLL phase is different for
+      every card and every power-up, so the host has to calibrate it before
+      SDR104 is used.
+
   qcom,ddr-config:
     $ref: /schemas/types.yaml#/definitions/uint32
     description: platform specific settings for DDR_CONFIG reg.
-- 
2.53.0

