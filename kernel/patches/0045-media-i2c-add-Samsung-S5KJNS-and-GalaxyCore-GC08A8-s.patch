+struct gc08a8_mode {
+	u32 width;
+	u32 height;
+	const struct gc08a8_reg_list reg_list;
+
+	u32 hts; /* Horizontal timining size */
+	u32 vts_def; /* Default vertical timining size */
+	u32 vts_min; /* Min vertical timining size */
+};
+
+/* Declare modes in order, from biggest to smallest height. */
+static const struct gc08a8_mode gc08a8_modes[] = {
+	{
+		/* 3264*2448@30fps */
+		.width = GC08A8_NATIVE_WIDTH,
+		.height = GC08A8_NATIVE_HEIGHT,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(mode_3264x2448),
+			.regs = mode_3264x2448,
+		},
+		.hts = 3640,
+		.vts_def = 2548,
+		.vts_min = 2548,
+	},
+};
+
+static inline struct gc08a8 *to_gc08a8(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc08a8, sd);
+}
+
+static int gc08a8_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc08a8 *gc08a8 = to_gc08a8(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc08a8_supply_name),
+				    gc08a8->supplies);
+	if (ret < 0) {
+		dev_err(gc08a8->dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(gc08a8->xclk);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(gc08a8_supply_name),
+				       gc08a8->supplies);
+		dev_err(gc08a8->dev, "clk prepare enable failed\n");
+		return ret;
+	}
+
+	fsleep(GC08A8_SLEEP_US);
+
+	gpiod_set_value_cansleep(gc08a8->reset_gpio, 0);
+	fsleep(GC08A8_SLEEP_US);
+
+	return 0;
+}
+
+static int gc08a8_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc08a8 *gc08a8 = to_gc08a8(sd);
+
+	clk_disable_unprepare(gc08a8->xclk);
+	gpiod_set_value_cansleep(gc08a8->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(gc08a8_supply_name),
+			       gc08a8->supplies);
+
+	return 0;
+}
+
+static int gc08a8_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = GC08A8_MBUS_CODE;
+
+	return 0;
+}
+
+static int gc08a8_enum_frame_size(struct v4l2_subdev *subdev,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != GC08A8_MBUS_CODE)
+		return -EINVAL;
+
+	if (fse->index >= ARRAY_SIZE(gc08a8_modes))
+		return -EINVAL;
+
+	fse->min_width = gc08a8_modes[fse->index].width;
+	fse->max_width = gc08a8_modes[fse->index].width;
+	fse->min_height = gc08a8_modes[fse->index].height;
+	fse->max_height = gc08a8_modes[fse->index].height;
+
+	return 0;
+}
+
+static int gc08a8_update_cur_mode_controls(struct gc08a8 *gc08a8,
+					   const struct gc08a8_mode *mode)
+{
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(gc08a8->vblank,
+				       mode->vts_min - mode->height,
+				       GC08A8_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret) {
+		dev_err(gc08a8->dev, "VB ctrl range update failed\n");
+		return ret;
+	}
+
+	h_blank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(gc08a8->hblank, h_blank, h_blank, 1,
+				       h_blank);
+	if (ret) {
+		dev_err(gc08a8->dev, "HB ctrl range update failed\n");
+		return ret;
+	}
+
+	exposure_max = mode->vts_def - GC08A8_EXP_MARGIN;
+	ret = __v4l2_ctrl_modify_range(gc08a8->exposure, GC08A8_EXP_MIN,
+				       exposure_max, GC08A8_EXP_STEP,
+				       exposure_max);
+	if (ret) {
+		dev_err(gc08a8->dev, "exposure ctrl range update failed\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void gc08a8_update_pad_format(struct gc08a8 *gc08a8,
+				     const struct gc08a8_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = GC08A8_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc08a8_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct gc08a8 *gc08a8 = to_gc08a8(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt;
+	struct v4l2_rect *crop;
+	const struct gc08a8_mode *mode;
+
+	mode = v4l2_find_nearest_size(gc08a8_modes, ARRAY_SIZE(gc08a8_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	/* update crop info to subdev state */
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	/* update fmt info to subdev state */
+	gc08a8_update_pad_format(gc08a8, mode, &fmt->format);
+	mbus_fmt = v4l2_subdev_state_get_format(state, 0);
+	*mbus_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	gc08a8->cur_mode = mode;
+	gc08a8_update_cur_mode_controls(gc08a8, mode);
+
+	return 0;
+}
+
+static int gc08a8_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = GC08A8_NATIVE_WIDTH;
+		sel->r.height = GC08A8_NATIVE_HEIGHT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int gc08a8_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = GC08A8_MBUS_CODE,
+			.width = gc08a8_modes[0].width,
+			.height = gc08a8_modes[0].height,
+		},
+	};
+
+	gc08a8_set_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int gc08a8_set_ctrl_hflip(struct gc08a8 *gc08a8, u32 ctrl_val)
+{
+	int ret;
+	u64 val;
+
+	ret = cci_read(gc08a8->regmap, GC08A8_FLIP_REG, &val, NULL);
+	if (ret) {
+		dev_err(gc08a8->dev, "read hflip register failed: %d\n", ret);
+		return ret;
+	}
+
+	return cci_update_bits(gc08a8->regmap, GC08A8_FLIP_REG,
+			       GC08A8_FLIP_H_MASK,
+			       ctrl_val ? GC08A8_FLIP_H_MASK : 0, NULL);
+}
+
+static int gc08a8_set_ctrl_vflip(struct gc08a8 *gc08a8, u32 ctrl_val)
+{
+	int ret;
+	u64 val;
+
+	ret = cci_read(gc08a8->regmap, GC08A8_FLIP_REG, &val, NULL);
+	if (ret) {
+		dev_err(gc08a8->dev, "read vflip register failed: %d\n", ret);
+		return ret;
+	}
+
+	return cci_update_bits(gc08a8->regmap, GC08A8_FLIP_REG,
+			       GC08A8_FLIP_V_MASK,
+			       ctrl_val ? GC08A8_FLIP_V_MASK : 0, NULL);
+}
+
+static int gc08a8_test_pattern(struct gc08a8 *gc08a8, u32 pattern_menu)
+{
+	u32 pattern;
+	int ret;
+
+	if (pattern_menu) {
+		switch (pattern_menu) {
+		case 1:
+			pattern = 0x00;
+			break;
+		case 2:
+			pattern = 0x10;
+			break;
+		case 3:
+		case 4:
+		case 5:
+		case 6:
+		case 7:
+			pattern = pattern_menu + 1;
+			break;
+		default:
+			pattern = 0x00;
+			break;
+		}
+
+		ret = cci_write(gc08a8->regmap, GC08A8_REG_TEST_PATTERN_IDX,
+				pattern, NULL);
+		if (ret)
+			return ret;
+
+		return cci_write(gc08a8->regmap, GC08A8_REG_TEST_PATTERN_EN,
+				 GC08A8_TEST_PATTERN_EN, NULL);
+	} else {
+		return cci_write(gc08a8->regmap, GC08A8_REG_TEST_PATTERN_EN,
+				 0x00, NULL);
+	}
+}
+
+static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc08a8 *gc08a8 =
+		container_of(ctrl->handler, struct gc08a8, ctrls);
+	int ret = 0;
+	s64 exposure_max;
+	struct v4l2_subdev_state *state;
+	const struct v4l2_mbus_framefmt *format;
+
+	state = v4l2_subdev_get_locked_active_state(&gc08a8->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = format->height + ctrl->val - GC08A8_EXP_MARGIN;
+		__v4l2_ctrl_modify_range(gc08a8->exposure,
+					 gc08a8->exposure->minimum,
+					 exposure_max, gc08a8->exposure->step,
+					 exposure_max);
+	}
+
+	/*
+	 * Applying V4L2 control value only happens
+	 * when power is on for streaming.
+	 */
+	if (!pm_runtime_get_if_active(gc08a8->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc08a8->regmap, GC08A8_EXP_REG,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(gc08a8->regmap, GC08A8_AGAIN_REG,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc08a8->regmap, GC08A8_FRAME_LENGTH_REG,
+				gc08a8->cur_mode->height + ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_HFLIP:
+		ret = gc08a8_set_ctrl_hflip(gc08a8, ctrl->val);
+		break;
+
+	case V4L2_CID_VFLIP:
+		ret = gc08a8_set_ctrl_vflip(gc08a8, ctrl->val);
+		break;
+
+	case V4L2_CID_TEST_PATTERN:
+		ret = gc08a8_test_pattern(gc08a8, ctrl->val);
+		break;
+
+	default:
+		break;
+	}
+
+	pm_runtime_put(gc08a8->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc08a8_ctrl_ops = {
+	.s_ctrl = gc08a8_set_ctrl,
+};
+
+static int gc08a8_start_streaming(struct gc08a8 *gc08a8)
+{
+	const struct gc08a8_mode *mode;
+	const struct gc08a8_reg_list *reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc08a8->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(gc08a8->regmap,
+				  mode_table_common,
+				  ARRAY_SIZE(mode_table_common), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	mode = gc08a8->cur_mode;
+	reg_list = &mode->reg_list;
+	ret = cci_multi_reg_write(gc08a8->regmap,
+				  reg_list->regs, reg_list->num_of_regs, NULL);
+	if (ret < 0)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc08a8->ctrls);
+	if (ret < 0) {
+		dev_err(gc08a8->dev, "could not sync v4l2 controls\n");
+		goto err_rpm_put;
+	}
+
+	ret = cci_write(gc08a8->regmap, GC08A8_STREAMING_REG, 1, NULL);
+	if (ret < 0) {
+		dev_err(gc08a8->dev, "write STREAMING_REG failed: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(gc08a8->dev);
+	return ret;
+}
+
+static int gc08a8_stop_streaming(struct gc08a8 *gc08a8)
+{
+	int ret;
+
+	ret = cci_write(gc08a8->regmap, GC08A8_STREAMING_REG, 0, NULL);
+	if (ret < 0)
+		dev_err(gc08a8->dev, "could not sent stop streaming %d\n", ret);
+
+	pm_runtime_put(gc08a8->dev);
+	return ret;
+}
+
+static int gc08a8_s_stream(struct v4l2_subdev *subdev, int enable)
+{
+	struct gc08a8 *gc08a8 = to_gc08a8(subdev);
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	state = v4l2_subdev_lock_and_get_active_state(subdev);
+
+	if (enable)
+		ret = gc08a8_start_streaming(gc08a8);
+	else
+		ret = gc08a8_stop_streaming(gc08a8);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc08a8_video_ops = {
+	.s_stream = gc08a8_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops gc08a8_subdev_pad_ops = {
+	.enum_mbus_code = gc08a8_enum_mbus_code,
+	.enum_frame_size = gc08a8_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc08a8_set_format,
+	.get_selection = gc08a8_get_selection,
+};
+
+static const struct v4l2_subdev_ops gc08a8_subdev_ops = {
+	.video = &gc08a8_video_ops,
+	.pad = &gc08a8_subdev_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc08a8_internal_ops = {
+	.init_state = gc08a8_init_state,
+};
+
+static int gc08a8_get_regulators(struct device *dev, struct gc08a8 *gc08a8)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gc08a8_supply_name); i++)
+		gc08a8->supplies[i].supply = gc08a8_supply_name[i];
+
+	return devm_regulator_bulk_get(dev, ARRAY_SIZE(gc08a8_supply_name),
+				       gc08a8->supplies);
+}
+
+static int gc08a8_parse_fwnode(struct gc08a8 *gc08a8)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret;
+	struct device *dev = gc08a8->dev;
+
+	endpoint =
+		fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err(dev, "parsing endpoint node failed\n");
+		goto done;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc08a8_link_freq_menu_items,
+				       ARRAY_SIZE(gc08a8_link_freq_menu_items),
+				       &gc08a8->link_freq_bitmap);
+	if (ret)
+		goto done;
+
+done:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static u64 gc08a8_to_pixel_rate(u32 f_index)
+{
+	u64 pixel_rate =
+		gc08a8_link_freq_menu_items[f_index] * 2 * GC08A8_DATA_LANES;
+
+	return div_u64(pixel_rate, GC08A8_RGB_DEPTH);
+}
+
+static int gc08a8_init_controls(struct gc08a8 *gc08a8)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&gc08a8->sd);
+	const struct gc08a8_mode *mode = &gc08a8_modes[0];
+	const struct v4l2_ctrl_ops *ops = &gc08a8_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ctrl_hdlr = &gc08a8->ctrls;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	gc08a8->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &gc08a8_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	gc08a8->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &gc08a8_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &gc08a8->hflip);
+
+	gc08a8->link_freq =
+	v4l2_ctrl_new_int_menu(ctrl_hdlr,
+			       &gc08a8_ctrl_ops,
+			       V4L2_CID_LINK_FREQ,
+			       ARRAY_SIZE(gc08a8_link_freq_menu_items) - 1,
+			       0,
+			       gc08a8_link_freq_menu_items);
+	if (gc08a8->link_freq)
+		gc08a8->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc08a8->pixel_rate =
+		v4l2_ctrl_new_std(ctrl_hdlr,
+				  &gc08a8_ctrl_ops,
+				  V4L2_CID_PIXEL_RATE, 0,
+				  gc08a8_to_pixel_rate(0),
+				  1,
+				  gc08a8_to_pixel_rate(0));
+
+	gc08a8->vblank =
+		v4l2_ctrl_new_std(ctrl_hdlr,
+				  &gc08a8_ctrl_ops, V4L2_CID_VBLANK,
+				  mode->vts_min - mode->height,
+				  GC08A8_VTS_MAX - mode->height, 1,
+				  mode->vts_def - mode->height);
+
+	h_blank = mode->hts - mode->width;
+	gc08a8->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &gc08a8_ctrl_ops,
+					   V4L2_CID_HBLANK, h_blank, h_blank, 1,
+					   h_blank);
+	if (gc08a8->hblank)
+		gc08a8->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &gc08a8_ctrl_ops,
+			  V4L2_CID_ANALOGUE_GAIN, GC08A8_AGAIN_MIN,
+			  GC08A8_AGAIN_MAX, GC08A8_AGAIN_STEP,
+			  GC08A8_AGAIN_MIN);
+
+	exposure_max = mode->vts_def - GC08A8_EXP_MARGIN;
+	gc08a8->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &gc08a8_ctrl_ops,
+					     V4L2_CID_EXPOSURE, GC08A8_EXP_MIN,
+					     exposure_max, GC08A8_EXP_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &gc08a8_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(gc08a8_test_pattern_menu) - 1,
+				     0, 0, gc08a8_test_pattern_menu);
+
+	/* register properties to fwnode (e.g. rotation, orientation) */
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error_ctrls;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, ops, &props);
+	if (ret)
+		goto error_ctrls;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_ctrls;
+	}
+
+	gc08a8->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_ctrls:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int gc08a8_identify_module(struct gc08a8 *gc08a8)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(gc08a8->regmap, GC08A8_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(gc08a8->dev, "failed to read chip id");
+		return ret;
+	}
+
+	if (val != GC08A8_CHIP_ID) {
+		dev_err(gc08a8->dev, "chip id mismatch: 0x%x!=0x%llx",
+			GC08A8_CHIP_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+static int gc08a8_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc08a8 *gc08a8;
+	int ret;
+
+	gc08a8 = devm_kzalloc(dev, sizeof(*gc08a8), GFP_KERNEL);
+	if (!gc08a8)
+		return -ENOMEM;
+
+	gc08a8->dev = dev;
+
+	ret = gc08a8_parse_fwnode(gc08a8);
+	if (ret)
+		return ret;
+
+	gc08a8->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc08a8->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc08a8->regmap),
+				     "failed to init CCI\n");
+
+	gc08a8->xclk = devm_v4l2_sensor_clk_get_legacy(dev, NULL, true,
+						       GC08A8_DEFAULT_CLK_FREQ);
+	if (IS_ERR(gc08a8->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc08a8->xclk),
+				     "failed to get xclk\n");
+
+	ret = gc08a8_get_regulators(dev, gc08a8);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "failed to get regulators\n");
+
+	gc08a8->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(gc08a8->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc08a8->reset_gpio),
+				     "failed to get gpio\n");
+
+	v4l2_i2c_subdev_init(&gc08a8->sd, client, &gc08a8_subdev_ops);
+	gc08a8->sd.internal_ops = &gc08a8_internal_ops;
+	gc08a8->cur_mode = &gc08a8_modes[0];
+
+	ret = gc08a8_power_on(gc08a8->dev);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to sensor power on\n");
+
+	ret = gc08a8_identify_module(gc08a8);
+	if (ret) {
+		dev_err(&client->dev, "failed to find sensor: %d\n", ret);
+		goto err_power_off;
+	}
+
+	ret = gc08a8_init_controls(gc08a8);
+	if (ret) {
+		dev_err(&client->dev, "failed to init controls: %d", ret);
+		goto err_power_off;
+	}
+
+	gc08a8->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc08a8->pad.flags = MEDIA_PAD_FL_SOURCE;
+	gc08a8->sd.dev = &client->dev;
+	gc08a8->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&gc08a8->sd.entity, 1, &gc08a8->pad);
+	if (ret < 0) {
+		dev_err(dev, "could not register media entity\n");
+		goto err_v4l2_ctrl_handler_free;
+	}
+
+	gc08a8->sd.state_lock = gc08a8->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc08a8->sd);
+	if (ret < 0) {
+		dev_err(dev, "v4l2 subdev init error: %d\n", ret);
+		goto err_media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(gc08a8->dev);
+	pm_runtime_enable(gc08a8->dev);
+	pm_runtime_set_autosuspend_delay(gc08a8->dev, 1000);
+	pm_runtime_use_autosuspend(gc08a8->dev);
+	pm_runtime_idle(gc08a8->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc08a8->sd);
+	if (ret < 0) {
+		dev_err(dev, "could not register v4l2 device\n");
+		goto err_rpm;
+	}
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(gc08a8->dev);
+	v4l2_subdev_cleanup(&gc08a8->sd);
+
+err_media_entity_cleanup:
+	media_entity_cleanup(&gc08a8->sd.entity);
+
+err_v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(gc08a8->sd.ctrl_handler);
+
+err_power_off:
+	gc08a8_power_off(gc08a8->dev);
+
+	return ret;
+}
+
+static void gc08a8_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc08a8 *gc08a8 = to_gc08a8(sd);
+
+	v4l2_async_unregister_subdev(&gc08a8->sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&gc08a8->sd.entity);
+	v4l2_ctrl_handler_free(&gc08a8->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc08a8_power_off(gc08a8->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc08a8_of_match[] = {
+	{ .compatible = "galaxycore,gc08a8" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gc08a8_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(gc08a8_pm_ops,
+				 gc08a8_power_off,
+				 gc08a8_power_on,
+				 NULL);
+
+static struct i2c_driver gc08a8_i2c_driver = {
+	.driver = {
+		.of_match_table = gc08a8_of_match,
+		.pm = pm_ptr(&gc08a8_pm_ops),
+		.name  = "gc08a8",
+	},
+	.probe  = gc08a8_probe,
+	.remove = gc08a8_remove,
+};
+module_i2c_driver(gc08a8_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore gc08a8 Camera driver");
+MODULE_AUTHOR("Zhi Mao <zhi.mao@mediatek.com>"); /* GC08A3 base */
+MODULE_AUTHOR("joonhoekim <26rote@gmail.com>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5kjns.c b/drivers/media/i2c/s5kjns.c
new file mode 100644
index 000000000..cd858b58f
--- /dev/null
+++ b/drivers/media/i2c/s5kjns.c
@@ -0,0 +1,1082 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5KJNS (ISOCELL JNS) 50 MP 10-bit RAW MIPI CSI-2 sensor driver
+ *
+ * Based on the S5KJNS driver (Copyright (c) Qualcomm Technologies, Inc.).
+ * The register sequences are the ones the Lenovo Legion Tab Y700 (5th gen)
+ * Android camera stack writes (module s5kjns_qtech_main), read back from
+ * its CCI debug log: reset, init, one 2x2-binned 4080x3072 mode at 30 fps.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define S5KJNS_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5KJNS_CHIP_ID			0x38ee
+
+/* 16 bit: mode select (0x0100) and image orientation (0x0101) */
+#define S5KJNS_REG_STREAMING		CCI_REG16(0x0100)
+#define S5KJNS_STREAMING_ON		0x0100
+#define S5KJNS_STREAMING_OFF		0x0000
+
+#define S5KJNS_REG_PAGE			CCI_REG16(0x6028)
+#define S5KJNS_PAGE_SFR			0x4000
+
+#define S5KJNS_REG_FRAME_COUNT	CCI_REG8(0x0005)
+#define S5KJNS_FRAME_COUNT_STANDBY	0xff
+#define S5KJNS_STANDBY_POLL_ITERS	20
+
+#define S5KJNS_REG_VTS		CCI_REG16(0x0340)
+#define S5KJNS_VTS_MAX		65535
+
+#define S5KJNS_REG_EXPOSURE	CCI_REG16(0x0202)
+
+/* Analogue gain: linear, reg = real * 32 */
+#define S5KJNS_REG_AGAIN	CCI_REG16(0x0204)
+#define S5KJNS_AGAIN_MIN	0x0020	/* 1x  */
+#define S5KJNS_AGAIN_MAX	0x0a00	/* 80x */
+
+/* Digital gain: reg = real * 256 */
+#define S5KJNS_REG_DGAIN	CCI_REG16(0x020e)
+#define S5KJNS_DGAIN_MIN	0x0100	/* 1x  */
+#define S5KJNS_DGAIN_MAX	0x1000	/* 16x */
+
+#define S5KJNS_REG_TEST_PATTERN	CCI_REG16(0x0600)
+
+#define S5KJNS_EXPOSURE_MIN	4
+#define S5KJNS_EXPOSURE_DEFAULT	0x0100
+
+#define S5KJNS_XVCLK_RATE	19200000
+
+#define S5KJNS_DATA_LANES	4
+#define S5KJNS_RGB_DEPTH	10
+
+/* Full 50.3 Mpx active pixel array */
+#define S5KJNS_NATIVE_WIDTH	8192
+#define S5KJNS_NATIVE_HEIGHT	6176
+
+/*
+ * From the mode's PLL (EXCLK 19.2 MHz): OP 19.2 / 3 (0x030e) * 105 (0x0310)
+ * = 672 MHz, VT 19.2 / 3 (0x0304) * 131 (0x0306) / 6 (0x0300) * 4 pixels
+ * per clock = 558.93 Mpx/s, which with 5840 x 3184 gives 30.06 fps.
+ */
+static const s64 s5kjns_link_freqs[] = {
+	672000000LL,
+};
+
+#define S5KJNS_PIXEL_RATE	558933333ULL
+
+static u64 s5kjns_to_pixel_rate(u32 f_index)
+{
+	return S5KJNS_PIXEL_RATE;
+}
+
+static const char * const s5kjns_supply_names[] = {
+	"vddio",	/* 1.8 V */
+	"vddd",		/* 1.072 V */
+	"vdda",		/* 2.848 V */
+	"afvdd",	/* 2.8 V, the VCM beside it */
+};
+
+struct s5kjns_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts_min;
+	u32 exposure_margin;
+	const struct cci_reg_sequence *regs;
+	u32 num_regs;
+};
+
+static const struct cci_reg_sequence s5kjns_reset_regs[] = {
+	{ CCI_REG16(0x6028), 0x4000 },
+	{ CCI_REG16(0x0000), 0x0001 },
+	{ CCI_REG16(0x0000), 0x38ee },
+	{ CCI_REG16(0x001e), 0x000b },
+	{ CCI_REG16(0x6028), 0x4000 },
+	{ CCI_REG16(0x6010), 0x0001 },
+};
+
+static const struct cci_reg_sequence s5kjns_init_regs[] = {
+	{ CCI_REG16(0x6226), 0x0001 },
+	{ CCI_REG16(0x6028), 0x2400 },
+	{ CCI_REG16(0x602a), 0x35cc },
+	{ CCI_REG16(0x6f12), 0x1c80 },
