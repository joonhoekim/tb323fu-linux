 obj-$(CONFIG_VIDEO_HI846) += hi846.o
@@ -134,6 +135,7 @@ obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
