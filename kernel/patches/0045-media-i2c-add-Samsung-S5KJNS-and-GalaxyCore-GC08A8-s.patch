From 3a74ecbb251580096250052e277a445ee47d327a Mon Sep 17 00:00:00 2001
From: joonhoekim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 01:30:48 +0000
Subject: [PATCH 45/56] media: i2c: add Samsung S5KJNS and GalaxyCore GC08A8
 sensor drivers

The TB323FU cameras (y705-mainline-plan.md 9-60). Both are the nearest
mainline driver (s5kjn5, gc08a3) with the register sequences the vendor
Android camera stack writes, read back from its CCI debug log:
- S5KJNS (rear): chip ID 0x38ee, one 2x2-binned 4080x3072 mode at 30 fps,
  4 lanes, link 672 MHz, EXCLK 19.2 MHz.
- GC08A8 (front): chip ID 0x08a8, common init + one 3264x2448 mode,
  19.2 MHz input clock.

y705-source: 0031-media-i2c-s5kjns-gc08a8.patch
---
 drivers/media/i2c/Kconfig  |   21 +
 drivers/media/i2c/Makefile |    2 +
 drivers/media/i2c/gc08a8.c | 1330 ++++++++++++++++++++++++++++++++++++
 drivers/media/i2c/s5kjns.c | 1082 +++++++++++++++++++++++++++++
 4 files changed, 2435 insertions(+)
 create mode 100644 drivers/media/i2c/gc08a8.c
 create mode 100644 drivers/media/i2c/s5kjns.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index be20324cc..025bdf3fe 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -100,6 +100,16 @@ config VIDEO_GC08A3
 	  To compile this driver as a module, choose M here: the
 	  module will be called gc08a3.
 
+config VIDEO_GC08A8
+	tristate "GalaxyCore gc08a8 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  Enable support for the GalaxyCore gc08a8 8MP 10-bit RAW
+	  MIPI CSI-2 camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called gc08a8.
+
 config VIDEO_GC2145
 	select V4L2_CCI_I2C
 	tristate "GalaxyCore GC2145 sensor support"
@@ -837,6 +847,17 @@ config VIDEO_S5KJN5
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5kjn5.
 
+config VIDEO_S5KJNS
+	tristate "Samsung S5KJNS sensor support"
+	depends on GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for Samsung S5KJNS (ISOCELL JNS)
+	  50MP 10-bit RAW MIPI CSI-2 camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5kjns.
+
 config VIDEO_T4KA3
 	tristate "Toshiba T4KA3 sensor support"
 	depends on ACPI || COMPILE_TEST
