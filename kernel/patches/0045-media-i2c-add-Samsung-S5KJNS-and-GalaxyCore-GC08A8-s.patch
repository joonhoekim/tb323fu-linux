+
+struct s5kjns {
+	struct v4l2_subdev	sd;
+	struct media_pad	pad;
+	struct regmap		*regmap;
+	struct clk		*inclk;
+	struct gpio_desc	*reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5kjns_supply_names)];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl	*link_freq;
+	struct v4l2_ctrl	*hblank;
+	struct v4l2_ctrl	*exposure;
+};
+
+static inline struct s5kjns *sd_to_s5kjns(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5kjns, sd);
+}
+
+static int s5kjns_write_init(struct s5kjns *s5kjns)
+{
+	int ret;
+
+	/* Soft reset (0x6010) at the end; the vendor waits ~15 ms after it. */
+	ret = cci_multi_reg_write(s5kjns->regmap, s5kjns_reset_regs,
+				  ARRAY_SIZE(s5kjns_reset_regs), NULL);
+	if (ret)
+		return ret;
+
+	fsleep(15000);
+
+	ret = cci_multi_reg_write(s5kjns->regmap, s5kjns_init_regs,
+				  ARRAY_SIZE(s5kjns_init_regs), NULL);
+	if (ret)
+		return ret;
+
+	fsleep(5000);
+
+	return 0;
+}
+
+static int s5kjns_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kjns *s5kjns = sd_to_s5kjns(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5kjns_supply_names),
+				    s5kjns->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(s5kjns->reset_gpio, 0);
+	usleep_range(8000, 10000);
+
+	ret = clk_prepare_enable(s5kjns->inclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		gpiod_set_value_cansleep(s5kjns->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s5kjns_supply_names),
+				       s5kjns->supplies);
+		return ret;
+	}
+
+	usleep_range(10000, 12000);
+
+	return 0;
+}
+
+static int s5kjns_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kjns *s5kjns = sd_to_s5kjns(sd);
+
+	clk_disable_unprepare(s5kjns->inclk);
+	gpiod_set_value_cansleep(s5kjns->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s5kjns_supply_names),
+			       s5kjns->supplies);
+
+	return 0;
+}
+
+static int s5kjns_check_id(struct s5kjns *s5kjns)
+{
+	struct device *dev = s5kjns->sd.dev;
+	u64 chip_id;
+	int ret;
+
+	ret = cci_read(s5kjns->regmap, S5KJNS_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip ID\n");
+
+	/*
+	 * Straight out of reset 0x0000/0x0001 read ee 38 (then a0 00); the
+	 * vendor stack, and this read after its init has run, see 0x38ee.
+	 * Take either order.
+	 */
+	if (chip_id != S5KJNS_CHIP_ID && chip_id != swab16(S5KJNS_CHIP_ID))
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected chip ID 0x%04llx, expected 0x%04x\n",
+				     chip_id, S5KJNS_CHIP_ID);
+
+	return 0;
+}
+
+static int s5kjns_check_hwcfg(struct device *dev)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return dev_err_probe(dev, -EINVAL, "no endpoint found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5KJNS_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only %u data lanes supported\n",
+				    S5KJNS_DATA_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5kjns_link_freqs,
+				       ARRAY_SIZE(s5kjns_link_freqs),
+				       &freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5kjns_init(struct s5kjns *s5kjns,
+		       const struct s5kjns_mode *mode)
+{
+	int ret;
+
+	ret = s5kjns_write_init(s5kjns);
+	if (ret)
+		return ret;
+
+	return cci_multi_reg_write(s5kjns->regmap, mode->regs,
+				   mode->num_regs, NULL);
+}
+
+static const char * const s5kjns_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Color",
+	"Color Bars",
+	"Fade To Grey Color Bars",
+	"PN9",
+};
+
+static int s5kjns_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5kjns *s5kjns =
+		container_of(ctrl->handler, struct s5kjns, ctrl_handler);
+	struct device *dev = s5kjns->sd.dev;
+	const struct s5kjns_mode *mode = &s5kjns_modes[0];
+	u32 exposure_max;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = mode->height + ctrl->val - mode->exposure_margin;
+		ret = __v4l2_ctrl_modify_range(s5kjns->exposure,
+					       s5kjns->exposure->minimum,
+					       exposure_max,
+					       s5kjns->exposure->step,
+					       s5kjns->exposure->default_value);
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_active(dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5kjns->regmap, S5KJNS_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5kjns->regmap, S5KJNS_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = cci_write(s5kjns->regmap, S5KJNS_REG_DGAIN,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5kjns->regmap, S5KJNS_REG_VTS,
+				mode->height + ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5kjns->regmap, S5KJNS_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5kjns_ctrl_ops = {
+	.s_ctrl = s5kjns_s_ctrl,
+};
+
+static int s5kjns_init_controls(struct s5kjns *s5kjns)
+{
+	const struct s5kjns_mode *mode = &s5kjns_modes[0];
+	struct v4l2_ctrl_handler *hdlr = &s5kjns->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	u32 vblank_min, vblank_def, vblank_max, hblank;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(s5kjns->sd.dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdlr, 10);
+
+	s5kjns->link_freq =
+		v4l2_ctrl_new_int_menu(hdlr, NULL, V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(s5kjns_link_freqs) - 1, 0,
+				       s5kjns_link_freqs);
+
+	v4l2_ctrl_new_std(hdlr, &s5kjns_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  0, s5kjns_to_pixel_rate(0), 1,
+			  s5kjns_to_pixel_rate(0));
+
+	vblank_min = mode->vts_min - mode->height;
+	vblank_def = mode->vts_min - mode->height;
+	vblank_max = S5KJNS_VTS_MAX - mode->height;
+	v4l2_ctrl_new_std(hdlr, &s5kjns_ctrl_ops, V4L2_CID_VBLANK,
+			  vblank_min, vblank_max, 1, vblank_def);
+
+	hblank = mode->hts - mode->width;
+	s5kjns->hblank =
+		v4l2_ctrl_new_std(hdlr, NULL, V4L2_CID_HBLANK,
+				  hblank, hblank, 1, hblank);
+
+	s5kjns->exposure =
+		v4l2_ctrl_new_std(hdlr, &s5kjns_ctrl_ops, V4L2_CID_EXPOSURE,
+				  S5KJNS_EXPOSURE_MIN,
+				  mode->vts_min - mode->exposure_margin,
+				  1, S5KJNS_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdlr, &s5kjns_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5KJNS_AGAIN_MIN, S5KJNS_AGAIN_MAX,
+			  1, S5KJNS_AGAIN_MIN);
+
+	v4l2_ctrl_new_std(hdlr, &s5kjns_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  S5KJNS_DGAIN_MIN, S5KJNS_DGAIN_MAX,
+			  1, S5KJNS_DGAIN_MIN);
+
+	v4l2_ctrl_new_std_menu_items(hdlr, &s5kjns_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5kjns_test_pattern_menu) - 1,
+				     0, 0, s5kjns_test_pattern_menu);
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdlr, &s5kjns_ctrl_ops, &props);
+	if (ret) {
+		v4l2_ctrl_handler_free(hdlr);
+		return ret;
+	}
+
+	if (hdlr->error) {
+		v4l2_ctrl_handler_free(hdlr);
+		return hdlr->error;
+	}
+
+	s5kjns->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	s5kjns->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5kjns->sd.ctrl_handler = hdlr;
+
+	return 0;
+}
+
+static int s5kjns_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct s5kjns *s5kjns = sd_to_s5kjns(sd);
+	const struct s5kjns_mode *mode = &s5kjns_modes[0];
+	struct device *dev = sd->dev;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = s5kjns_init(s5kjns, mode);
+	if (ret) {
+		dev_err(dev, "failed to write init registers: %d\n", ret);
+		goto err_pm;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&s5kjns->ctrl_handler);
+	if (ret)
+		goto err_pm;
+
+	cci_write(s5kjns->regmap, S5KJNS_REG_PAGE, S5KJNS_PAGE_SFR, &ret);
+	cci_write(s5kjns->regmap, S5KJNS_REG_STREAMING,
+		  S5KJNS_STREAMING_ON, &ret);
+	if (ret) {
+		dev_err(dev, "failed to start streaming: %d\n", ret);
+		goto err_pm;
+	}
+
+	return 0;
+
+err_pm:
+	pm_runtime_put_autosuspend(dev);
+	return ret;
+}
+
+static int s5kjns_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct s5kjns *s5kjns = sd_to_s5kjns(sd);
+	struct device *dev = sd->dev;
+	u64 val;
+	int ret;
+	int i;
+
+	ret = cci_write(s5kjns->regmap, S5KJNS_REG_STREAMING,
+			S5KJNS_STREAMING_OFF, NULL);
+	if (ret)
+		dev_warn(dev, "failed to stop streaming: %d\n", ret);
+
+	/* Poll frame count register until it reads standby */
+	for (i = 0; i < S5KJNS_STANDBY_POLL_ITERS; i++) {
+		usleep_range(5000, 6000);
+		ret = cci_read(s5kjns->regmap, S5KJNS_REG_FRAME_COUNT,
+			       &val, NULL);
+		if (!ret && val == S5KJNS_FRAME_COUNT_STANDBY)
+			break;
+	}
+	if (i == S5KJNS_STANDBY_POLL_ITERS)
+		dev_warn(dev, "timed out waiting for standby\n");
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+}
+
+static int s5kjns_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGBRG10_1X10;
+
+	return 0;
+}
+
+static int s5kjns_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != MEDIA_BUS_FMT_SGBRG10_1X10 ||
+	    fse->index >= ARRAY_SIZE(s5kjns_modes))
+		return -EINVAL;
+
+	fse->min_width  = s5kjns_modes[fse->index].width;
+	fse->max_width  = s5kjns_modes[fse->index].width;
+	fse->min_height = s5kjns_modes[fse->index].height;
+	fse->max_height = s5kjns_modes[fse->index].height;
+
+	return 0;
+}
+
+static void s5kjns_fill_format(const struct s5kjns_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width	= mode->width;
+	fmt->height	= mode->height;
+	fmt->code	= MEDIA_BUS_FMT_SGBRG10_1X10;
+	fmt->field	= V4L2_FIELD_NONE;
+	fmt->colorspace	= V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc	= V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func	= V4L2_XFER_FUNC_NONE;
+}
+
+static int s5kjns_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	const struct s5kjns_mode *mode = &s5kjns_modes[0];
+	struct v4l2_mbus_framefmt *format;
+
+	s5kjns_fill_format(mode, &fmt->format);
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	return 0;
+}
+
+static int s5kjns_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5KJNS_NATIVE_WIDTH;
+		sel->r.height = S5KJNS_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5kjns_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt =
+		v4l2_subdev_state_get_format(state, 0);
+
+	s5kjns_fill_format(&s5kjns_modes[0], fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5kjns_video_ops = {
+	.s_stream	= v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5kjns_pad_ops = {
+	.enum_mbus_code		= s5kjns_enum_mbus_code,
+	.enum_frame_size	= s5kjns_enum_frame_size,
+	.get_fmt		= v4l2_subdev_get_fmt,
+	.set_fmt		= s5kjns_set_fmt,
+	.get_selection		= s5kjns_get_selection,
+	.enable_streams		= s5kjns_enable_streams,
+	.disable_streams	= s5kjns_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5kjns_subdev_ops = {
+	.video	= &s5kjns_video_ops,
+	.pad	= &s5kjns_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5kjns_internal_ops = {
+	.init_state	= s5kjns_init_state,
+};
+
+static int s5kjns_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5kjns *s5kjns;
+	unsigned int i;
+	int ret;
+
+	s5kjns = devm_kzalloc(dev, sizeof(*s5kjns), GFP_KERNEL);
+	if (!s5kjns)
+		return -ENOMEM;
+
+	ret = s5kjns_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&s5kjns->sd, client, &s5kjns_subdev_ops);
+
+	s5kjns->inclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(s5kjns->inclk))
+		return dev_err_probe(dev, PTR_ERR(s5kjns->inclk),
+				     "failed to get clock\n");
+
+	if (clk_get_rate(s5kjns->inclk) != S5KJNS_XVCLK_RATE)
+		return dev_err_probe(dev, -EINVAL,
+				     "unsupported clock rate %lu Hz, expected %u Hz\n",
+				     clk_get_rate(s5kjns->inclk),
+				     S5KJNS_XVCLK_RATE);
+
+	s5kjns->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5kjns->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5kjns->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5kjns_supply_names); i++)
+		s5kjns->supplies[i].supply = s5kjns_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s5kjns_supply_names),
+				      s5kjns->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to get regulators\n");
+
+	s5kjns->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5kjns->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5kjns->regmap),
+				     "failed to init CCI regmap\n");
+
+	ret = s5kjns_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = s5kjns_check_id(s5kjns);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5kjns_init_controls(s5kjns);
+	if (ret)
+		goto err_power_off;
+
+	s5kjns->sd.internal_ops = &s5kjns_internal_ops;
+	s5kjns->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5kjns->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5kjns->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5kjns->sd.entity, 1, &s5kjns->pad);
+	if (ret)
+		goto err_controls;
+
+	s5kjns->sd.state_lock = s5kjns->ctrl_handler.lock;
+
+	ret = v4l2_subdev_init_finalize(&s5kjns->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5kjns->sd);
+	if (ret) {
+		dev_err(dev, "failed to register subdev: %d\n", ret);
+		goto err_pm;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	dev_dbg(dev, "S5KJNS sensor detected (chip ID 0x%04x)\n",
+		S5KJNS_CHIP_ID);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+
+err_entity:
+	media_entity_cleanup(&s5kjns->sd.entity);
+	v4l2_subdev_cleanup(&s5kjns->sd);
+
+err_controls:
+	v4l2_ctrl_handler_free(&s5kjns->ctrl_handler);
+
+err_power_off:
+	s5kjns_power_off(dev);
+	return ret;
+}
+
+static void s5kjns_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct device *dev = &client->dev;
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	media_entity_cleanup(&sd->entity);
+
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+
+	if (!pm_runtime_status_suspended(dev)) {
+		s5kjns_power_off(dev);
+		pm_runtime_set_suspended(dev);
+	}
+}
+
+static const struct dev_pm_ops s5kjns_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5kjns_power_off, s5kjns_power_on, NULL)
+};
+
+static const struct of_device_id s5kjns_of_match[] = {
+	{ .compatible = "samsung,s5kjns" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5kjns_of_match);
+
+static struct i2c_driver s5kjns_i2c_driver = {
+	.driver = {
+		.name		= "s5kjns",
+		.pm		= pm_ptr(&s5kjns_pm_ops),
+		.of_match_table	= s5kjns_of_match,
+	},
+	.probe		= s5kjns_probe,
+	.remove		= s5kjns_remove,
+};
+
+module_i2c_driver(s5kjns_i2c_driver);
+
+MODULE_AUTHOR("Wenmeng Liu <wenmeng.liu@oss.qualcomm.com>"); /* S5KJN5 base */
+MODULE_AUTHOR("joonhoekim <26rote@gmail.com>");
+MODULE_DESCRIPTION("Samsung S5KJNS 50 MP 10-bit RAW sensor driver");
+MODULE_LICENSE("GPL");
