From 6504f1b9cf06c5a0fa00737e6c6809b19402434f Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 01:30:47 +0000
Subject: [PATCH 44/56] pinctrl: qcom: kaanapali: add the I2C strong pull-up
 bit

Kaanapali's TLMM has the I2C pull bit (13) that SM8550/SM8650 describe as
.i2c_pull_bit: with it, "bias-pull-up = <2200>" selects the strong pull-up.
Android sets it on the camera CCI pins (cfg 0x2007); without it the camera
buses only have the weak pull-up and the CCI times out on every transfer.
---
 drivers/pinctrl/qcom/pinctrl-kaanapali.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/pinctrl/qcom/pinctrl-kaanapali.c b/drivers/pinctrl/qcom/pinctrl-kaanapali.c
index e95ac064b..e9351e29d 100644
--- a/drivers/pinctrl/qcom/pinctrl-kaanapali.c
+++ b/drivers/pinctrl/qcom/pinctrl-kaanapali.c
@@ -37,6 +37,7 @@
 		.mux_bit = 2,			\
 		.pull_bit = 0,			\
 		.drv_bit = 6,			\
+		.i2c_pull_bit = 13,		\
 		.egpio_enable = 12,		\
 		.egpio_present = 11,		\
 		.oe_bit = 9,			\
-- 
