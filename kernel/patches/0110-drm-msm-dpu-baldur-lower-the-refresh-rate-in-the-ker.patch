 	trace_dpu_enc_disable(DRMID(drm_enc));
@@ -2134,6 +2151,462 @@ static void dpu_encoder_prep_dsc(struct dpu_encoder_virt *dpu_enc,
  *	Delayed: Block until next trigger can be issued.
  * @drm_enc:	encoder pointer
