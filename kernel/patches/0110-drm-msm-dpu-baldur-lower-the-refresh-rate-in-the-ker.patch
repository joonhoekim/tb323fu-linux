+
+/*
+ * Idle refresh inside the kernel.
+ *
+ * The committed mode stays 120 Hz; when the screen is idle the vertical front
+ * porch of the running DSI video interface is stretched (vtotal 3400 -> 6800
+ * -> 13600 = 120 -> 60 -> 30 Hz) and the INTFs are flushed outside a commit,
+ * so userspace never sees a mode change. The next commit (auto policy) or an
+ * input event brings it back to the mode.
+ *
+ * Knobs, /sys/module/msm/parameters/idle_refresh_*:
+ *   policy     0 off, 1 manual (idle_refresh_hz is kept across commits),
+ *              2 auto (ms60 / ms30 without commits -> 60 / 30 Hz; default)
+ *   hz         manual rate (e.g. 120, 60, 30)
+ *   ms60 ms30  auto thresholds in ms (default 1000 / 5000)
+ *   min_hz     lowest rate ever programmed (default 30)
+ *   input      1 = an input event returns to the mode at once (auto)
+ *   selfflush  bit0 flush the INTFs outside a commit (without it a change only
+ *              lands with the next commit), bit1 add the CTL bit (default 3)
+ *   state      read-only: current values and counters
+ * Before system suspend and on encoder disable the mode's vtotal is restored
+ * and latched first.
+ */
+static int idle_refresh_policy = 2;
+static unsigned int idle_refresh_hz = 60;
+static unsigned int idle_refresh_ms60 = 1000;
+static unsigned int idle_refresh_ms30 = 5000;
+static unsigned int idle_refresh_min_hz = 30;
+static bool idle_refresh_input = true;
+static unsigned int idle_refresh_selfflush = 3;
+
+static struct dpu_encoder_virt *idle_refresh_enc;
+static bool idle_refresh_suspending;
+static struct {
+	unsigned int stretch, restore_kick, input_kick, flush, busy, nolatch;
+} idle_refresh_cnt;
+
+module_param_named(idle_refresh_ms60, idle_refresh_ms60, uint, 0644);
+module_param_named(idle_refresh_ms30, idle_refresh_ms30, uint, 0644);
+module_param_named(idle_refresh_min_hz, idle_refresh_min_hz, uint, 0644);
+module_param_named(idle_refresh_input, idle_refresh_input, bool, 0644);
+module_param_named(idle_refresh_selfflush, idle_refresh_selfflush, uint, 0644);
+
+static void idle_refresh_kick_work(unsigned long delay)
+{
+	struct dpu_encoder_virt *e = READ_ONCE(idle_refresh_enc);
+
+	if (e)
+		mod_delayed_work(system_highpri_wq, &e->idle_refresh_work, delay);
+}
+
+static int idle_refresh_set_kick(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret)
+		idle_refresh_kick_work(0);
+	return ret;
+}
+
+static const struct kernel_param_ops idle_refresh_kick_ops = {
+	.set = idle_refresh_set_kick,
+	.get = param_get_uint,
+};
+module_param_cb(idle_refresh_policy, &idle_refresh_kick_ops, &idle_refresh_policy, 0644);
+module_param_cb(idle_refresh_hz, &idle_refresh_kick_ops, &idle_refresh_hz, 0644);
+
+static int idle_refresh_state_get(char *buf, const struct kernel_param *kp)
+{
+	struct dpu_encoder_virt *e = READ_ONCE(idle_refresh_enc);
+	unsigned int hz = 0, idle = 0;
+
+	if (e && e->idle_refresh_live_vt)
+		hz = DIV_ROUND_CLOSEST(drm_mode_vrefresh(&e->idle_refresh_base_mode) * e->idle_refresh_base_vt,
+				       e->idle_refresh_live_vt);
+	if (e)
+		idle = jiffies_to_msecs(jiffies - e->idle_refresh_last_kick);
+	return sysfs_emit(buf,
+		"policy %d enabled %d suspending %d base %u live %u hz %u idle_ms %u "
+		"stretch %u restore_kick %u input_kick %u flush %u busy %u nolatch %u\n",
+		idle_refresh_policy, e ? e->enabled : 0, idle_refresh_suspending,
+		e ? e->idle_refresh_base_vt : 0, e ? e->idle_refresh_live_vt : 0, hz, idle,
+		idle_refresh_cnt.stretch, idle_refresh_cnt.restore_kick, idle_refresh_cnt.input_kick,
+		idle_refresh_cnt.flush, idle_refresh_cnt.busy, idle_refresh_cnt.nolatch);
+}
+
+static const struct kernel_param_ops idle_refresh_state_ops = {
+	.get = idle_refresh_state_get,
+};
+module_param_cb(idle_refresh_state, &idle_refresh_state_ops, NULL, 0444);
+
+u32 dpu_encoder_idle_refresh_live_vtotal(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+
+	return dpu_enc == READ_ONCE(idle_refresh_enc) ? READ_ONCE(dpu_enc->idle_refresh_live_vt) : 0;
+}
+
+/* @base with the vertical front porch stretched to @vtotal lines */
+static void idle_refresh_stretch_mode(struct drm_display_mode *m,
+			      const struct drm_display_mode *base, u32 vtotal)
+{
+	int d = (int)vtotal - base->vtotal;
+
+	drm_mode_copy(m, base);
+	if (d <= 0)
+		return;
+	m->vsync_start += d;
+	m->vsync_end += d;
+	m->vtotal += d;
+	m->crtc_vsync_start += d;
+	m->crtc_vsync_end += d;
+	m->crtc_vtotal += d;
+	m->crtc_vblank_end += d;
+}
+
+/*
+ * The vtotal the policy wants now for @base. @kick: called for a commit.
+ * *@next: jiffies until the policy should look again (0 = no need).
+ */
+static u32 idle_refresh_target(struct dpu_encoder_virt *e,
+			    const struct drm_display_mode *base, bool kick,
+			    unsigned long *next)
+{
+	unsigned int hz = drm_mode_vrefresh(base), want = hz;
+	unsigned long idle, t60, t30, last;
+	u32 vt;
+
+	*next = 0;
+	if (READ_ONCE(idle_refresh_suspending) || !hz)
+		return base->vtotal;
+	switch (READ_ONCE(idle_refresh_policy)) {
+	case 1:
+		want = READ_ONCE(idle_refresh_hz);
+		break;
+	case 2:
+		if (kick)
+			return base->vtotal;
+		last = e->idle_refresh_last_kick;
+		if (idle_refresh_input && time_after(e->idle_refresh_last_input, last))
+			last = e->idle_refresh_last_input;
+		idle = jiffies - last;
+		t60 = msecs_to_jiffies(idle_refresh_ms60);
+		t30 = msecs_to_jiffies(max(idle_refresh_ms30, idle_refresh_ms60));
+		if (idle >= t30) {
+			want = 30;
+		} else if (idle >= t60) {
+			want = 60;
+			*next = t30 - idle;
+		} else {
+			*next = t60 - idle;
+		}
+		break;
+	default:
+		return base->vtotal;
+	}
+	if (want < idle_refresh_min_hz)
+		want = idle_refresh_min_hz;
+	if (!want || want >= hz)
+		return base->vtotal;
+	vt = DIV_ROUND_UP(base->vtotal * hz, want);
+	return min_t(u32, vt, 20000);
+}
+
+/*
+ * Write @vtotal into the DSI hosts and the INTFs (phys update_vfp() also marks
+ * the INTFs in the next commit's pending flush). Caller holds the CRTC's
+ * commit_lock. Returns true if anything was written.
+ */
+static bool idle_refresh_program(struct dpu_encoder_virt *e, u32 vtotal)
+{
+	struct msm_drm_private *priv = e->base.dev->dev_private;
+	struct drm_display_mode m;
+	unsigned int i;
+
+	if (vtotal == e->idle_refresh_live_vt &&
+	    e->phys_encs[0]->cached_mode.vtotal == vtotal)
+		return false;
+	idle_refresh_stretch_mode(&m, &e->idle_refresh_base_mode, vtotal);
+	for (i = 0; i < e->disp_info.num_of_h_tiles; i++)
+		msm_dsi_idle_refresh_live_vtotal(priv->kms->dsi[e->disp_info.h_tile_instance[i]], vtotal);
+	for (i = 0; i < e->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = e->phys_encs[i];
+
+		if (phys->ops.update_vfp)
+			phys->ops.update_vfp(phys, &m);
+	}
+	if (vtotal > e->idle_refresh_base_vt)
+		idle_refresh_cnt.stretch++;
+	WRITE_ONCE(e->idle_refresh_live_vt, vtotal);
+	return true;
+}
+
+/* flush the INTFs of every CTL of the encoder, outside a commit */
+static void idle_refresh_self_flush(struct dpu_encoder_virt *e)
+{
+	struct dpu_hw_ctl *ctl = NULL;
+	u32 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < e->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = e->phys_encs[i];
+
+		if (!phys->hw_intf || !phys->hw_ctl)
+			continue;
+		if (ctl && ctl != phys->hw_ctl) {
+			dpu_hw_ctl_idle_refresh_flush_intf(ctl, mask, idle_refresh_selfflush & 2);
+			mask = 0;
+		}
+		ctl = phys->hw_ctl;
+		mask |= BIT(phys->hw_intf->idx - INTF_0);
+	}
+	if (ctl && mask)
+		dpu_hw_ctl_idle_refresh_flush_intf(ctl, mask, idle_refresh_selfflush & 2);
+	idle_refresh_cnt.flush++;
+}
+
+static bool idle_refresh_flush_busy(struct dpu_encoder_virt *e, struct drm_crtc *crtc)
+{
+	struct msm_drm_private *priv = e->base.dev->dev_private;
+	struct dpu_hw_ctl *ctl = e->phys_encs[0]->hw_ctl;
+
+	if (ctl && ctl->ops.get_flush_register && ctl->ops.get_flush_register(ctl))
+		return true;	/* a flush is still waiting for its vsync */
+	return priv->kms->pending_crtc_mask & drm_crtc_mask(crtc);	/* async commit */
+}
+
+/* wait (at most ~2 stretched frames) until the CTL flush has latched */
+static bool idle_refresh_wait_latch(struct dpu_encoder_virt *e)
+{
+	struct dpu_hw_ctl *ctl = e->phys_encs[0]->hw_ctl;
+	int i;
+
+	for (i = 0; i < 70; i++) {
+		if (!ctl || !ctl->ops.get_flush_register || !ctl->ops.get_flush_register(ctl))
+			return true;
+		usleep_range(1000, 1200);
+	}
+	idle_refresh_cnt.nolatch++;
+	return false;
+}
+
+/*
+ * Apply @vtotal now. Caller holds the commit_lock. @force: also while the
+ * CRTC is being disabled. -EBUSY: a flush is in flight, try again later.
+ */
+static int idle_refresh_apply_locked(struct dpu_encoder_virt *e, u32 vtotal, bool force)
+{
+	struct drm_crtc *crtc = e->base.crtc;
+	bool flush = idle_refresh_selfflush & 1;
+
+	/*
+	 * Video mode enters RC IDLE 58 ms after the last frame, but that only
+	 * masks the interrupts; the clocks and registers stay on.
+	 */
+	if (!crtc || !e->num_phys_encs ||
+	    (e->rc_state != DPU_ENC_RC_STATE_ON && e->rc_state != DPU_ENC_RC_STATE_IDLE))
+		return -ENODEV;
+	if (!force && (!e->enabled || !crtc->state || !crtc->state->active ||
+		       crtc->state->adjusted_mode.vtotal != e->idle_refresh_base_vt))
+		return -EAGAIN;	/* off, or a real mode change is on its way */
+	if (vtotal == e->idle_refresh_live_vt)
+		return 0;
+	if (flush && idle_refresh_flush_busy(e, crtc)) {
+		idle_refresh_cnt.busy++;
+		return -EBUSY;
+	}
+	if (idle_refresh_program(e, vtotal) && flush)
+		idle_refresh_self_flush(e);
+	return 0;
+}
+
+static void idle_refresh_work_fn(struct work_struct *work)
+{
+	struct dpu_encoder_virt *e = container_of(to_delayed_work(work),
+						  struct dpu_encoder_virt, idle_refresh_work);
+	struct msm_drm_private *priv = e->base.dev->dev_private;
+	struct drm_crtc *crtc = e->base.crtc;
+	unsigned long next = 0;
+	struct mutex *lock;
+	int ret;
+
+	if (!e->enabled || !crtc)
+		return;
+	lock = &priv->kms->commit_lock[drm_crtc_index(crtc)];
+	/* never block: a commit that disables us waits for this work */
+	if (!mutex_trylock(lock)) {
+		mod_delayed_work(system_highpri_wq, &e->idle_refresh_work, msecs_to_jiffies(5));
+		return;
+	}
+	ret = idle_refresh_apply_locked(e, idle_refresh_target(e, &e->idle_refresh_base_mode, false, &next),
+				     false);
+	mutex_unlock(lock);
+	if (ret == -EBUSY)
+		next = msecs_to_jiffies(5);
+	if (next)
+		mod_delayed_work(system_highpri_wq, &e->idle_refresh_work, next);
+}
+
+/* back to the mode and wait for it to latch; caller holds the commit_lock */
+static void idle_refresh_restore_locked(struct dpu_encoder_virt *e)
+{
+	int i;
+
+	if (!e->idle_refresh_live_vt || e->idle_refresh_live_vt == e->idle_refresh_base_vt)
+		return;
+	for (i = 0; i < 20; i++) {
+		if (idle_refresh_apply_locked(e, e->idle_refresh_base_vt, true) != -EBUSY)
+			break;
+		idle_refresh_wait_latch(e);
+	}
+	idle_refresh_wait_latch(e);
+	pr_info("idle refresh: restored vtotal %u before disable/suspend\n", e->idle_refresh_base_vt);
+}
+
+static void idle_refresh_input_event(struct input_handle *handle, unsigned int type,
+			     unsigned int code, int value)
+{
+	struct dpu_encoder_virt *e = READ_ONCE(idle_refresh_enc);
+
+	if (!e || READ_ONCE(idle_refresh_policy) != 2 || !idle_refresh_input)
+		return;
+	e->idle_refresh_last_input = jiffies;
+	if (READ_ONCE(e->idle_refresh_live_vt) != e->idle_refresh_base_vt) {
+		idle_refresh_cnt.input_kick++;
+		mod_delayed_work(system_highpri_wq, &e->idle_refresh_work, 0);
+	}
+}
+
+static int idle_refresh_input_connect(struct input_handler *handler, struct input_dev *dev,
+			      const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int err;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "idle_refresh";
+	err = input_register_handle(handle);
+	if (err)
+		goto err_free;
+	err = input_open_device(handle);
+	if (err)
+		goto err_unregister;
+	return 0;
+err_unregister:
+	input_unregister_handle(handle);
+err_free:
+	kfree(handle);
+	return err;
+}
+
+static void idle_refresh_input_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id idle_refresh_input_ids[] = {
+	{	/* touchscreens */
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_ABSBIT,
+		.evbit = { BIT_MASK(EV_ABS) },
+		.absbit = { [BIT_WORD(ABS_MT_POSITION_X)] = BIT_MASK(ABS_MT_POSITION_X) },
+	},
+	{	/* keys, keyboards, buttons */
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+	},
+	{	/* mice */
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT,
+		.evbit = { BIT_MASK(EV_REL) },
+	},
+	{ },
+};
+
+static struct input_handler idle_refresh_input_handler = {
+	.event		= idle_refresh_input_event,
+	.connect	= idle_refresh_input_connect,
+	.disconnect	= idle_refresh_input_disconnect,
+	.name		= "idle_refresh",
+	.id_table	= idle_refresh_input_ids,
+};
+
+static int idle_refresh_pm_notify(struct notifier_block *nb, unsigned long ev, void *unused)
+{
+	struct dpu_encoder_virt *e = READ_ONCE(idle_refresh_enc);
+	struct msm_drm_private *priv;
+	struct drm_crtc *crtc;
+
+	switch (ev) {
+	case PM_SUSPEND_PREPARE:
+	case PM_HIBERNATION_PREPARE:
+		WRITE_ONCE(idle_refresh_suspending, true);
+		if (!e)
+			break;
+		cancel_delayed_work_sync(&e->idle_refresh_work);
+		crtc = e->base.crtc;
+		if (!e->enabled || !crtc)
+			break;
+		priv = e->base.dev->dev_private;
+		mutex_lock(&priv->kms->commit_lock[drm_crtc_index(crtc)]);
+		if (e->enabled)
+			idle_refresh_restore_locked(e);
+		mutex_unlock(&priv->kms->commit_lock[drm_crtc_index(crtc)]);
+		break;
+	case PM_POST_SUSPEND:
+	case PM_POST_HIBERNATION:
+		WRITE_ONCE(idle_refresh_suspending, false);
