+/*
+ * idle refresh. Flush the given INTFs (bit n = INTF_n) outside a
+ * commit, without touching the cached pending masks of the next commit.
+ * Same register sequence as dpu_hw_ctl_trigger_flush_v1(): the INTF sub-flush,
+ * then CTL_FLUSH. @ctl_bit adds the CTL bit a normal commit flush always has.
+ */
+void dpu_hw_ctl_idle_refresh_flush_intf(struct dpu_hw_ctl *ctx, u32 intf_mask, bool ctl_bit)
+{
+	u32 flush = ctl_bit ? CTL_FLUSH_MASK_CTL : 0;
+	int i;
+
+	if (ctx->mdss_ver->core_major_ver >= 5) {
+		DPU_REG_WRITE(&ctx->hw, CTL_INTF_FLUSH, intf_mask);
+		flush |= BIT(INTF_IDX);
+	} else {
+		for (i = 0; i < 4; i++)
+			if (intf_mask & BIT(i))
+				flush |= BIT(31 - i);
+	}
+	DPU_REG_WRITE(&ctx->hw, CTL_FLUSH, flush);
+}
