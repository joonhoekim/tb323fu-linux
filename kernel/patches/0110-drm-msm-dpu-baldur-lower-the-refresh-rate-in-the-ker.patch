+/*
+ * Idle refresh.
+ * Rewrite V_TOTAL only; unlike msm_dsi_host_update_vtotal() the stored mode is
+ * left alone, so the next power-on programs the committed mode, never the
+ * stretched one.
+ */
+void msm_dsi_host_idle_refresh_live_vtotal(struct mipi_dsi_host *host, u32 vtotal)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 total;
+
+	if (!msm_host->power_on)
+		return;
+	total = dsi_read(msm_host, REG_DSI_TOTAL);
+	total &= ~DSI_TOTAL_V_TOTAL__MASK;
+	dsi_write(msm_host, REG_DSI_TOTAL, total | DSI_TOTAL_V_TOTAL(vtotal - 1));
+}
