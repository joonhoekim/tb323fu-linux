diff --git a/drivers/net/wireless/ath/ath12k/dp.h b/drivers/net/wireless/ath/ath12k/dp.h
index bef0f2ba0..dc8001345 100644
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -450,6 +450,15 @@ struct ath12k_device_dp_stats {
 	u32 tx_enqueued[DP_TCL_NUM_RING_MAX];
 	u32 tx_completed[DP_TCL_NUM_RING_MAX];
 	u32 reo_excep_msdu_buf_type;
+	/* RX refill ring accounting */
+	u32 rx_replenish_alloc_fail;
+	u32 rx_replenish_map_fail;
+	u32 rx_replenish_no_desc;
+	u32 rx_reap_no_msdu;
+	u32 rx_refill_topup_bufs;
+	u32 rx_refill_wd_runs;
+	u32 rx_refill_wd_bufs;
+	u32 rx_refill_wd_stalls;
 };
 
 struct ath12k_dp {
@@ -507,6 +516,20 @@ struct ath12k_dp {
 	spinlock_t tx_desc_lock[ATH12K_HW_MAX_QUEUES];
 
 	struct dp_rxdma_ring rx_refill_buf_ring;
+	/* completes the initial fill of rx_refill_buf_ring and tops it up
+	 * when nothing is reaped any more
+	 */
+	struct timer_list rx_refill_wd;
+	struct ratelimit_state rx_refill_wd_rs;
+	/* buffers posted to rx_refill_buf_ring, under its srng lock */
+	u32 rx_refill_posted;
+	/* rx_refill_posted as of the last watchdog run */
+	u32 rx_refill_wd_posted;
+	/* rx_refill_posted at which the initial fill ends */
+	u32 rx_refill_fill_end;
+	bool rx_refill_wd_init;
+	/* the initial fill is still going on */
+	bool rx_refill_filling;
 	struct dp_srng rx_mac_buf_ring[MAX_RXDMA_PER_PDEV];
 	struct dp_srng rxdma_err_dst_ring[MAX_RXDMA_PER_PDEV];
 	struct dp_rxdma_mon_ring rxdma_mon_buf_ring;
diff --git a/drivers/net/wireless/ath/ath12k/dp_rx.c b/drivers/net/wireless/ath/ath12k/dp_rx.c
index 8fa0e90b4..b5d2693f5 100644
--- a/drivers/net/wireless/ath/ath12k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.c
@@ -7,6 +7,7 @@
 #include <linux/fips.h>
 #include <linux/ieee80211.h>
 #include <linux/kernel.h>
+#include <linux/ratelimit.h>
 #include <linux/skbuff.h>
 #include "core.h"
 #include "debug.h"
@@ -111,13 +112,33 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 						       num_remain);
 		spin_unlock_bh(&dp->rx_desc_lock);
 		num_remain = req_entries;
+	} else if (num_free - req_entries > rx_ring->bufs_max / 8) {
+		/* The callers replenish as many buffers as they reaped, so a
+		 * buffer that was not posted back (allocation or mapping
+		 * failure, a dropped descriptor) is never made up for, and
+		 * once the ring runs dry nothing is reaped any more. Top up
+		 * the deficit from the free list.
+		 */
+		LIST_HEAD(extra);
+		size_t n;
+
+		spin_lock_bh(&dp->rx_desc_lock);
+		n = ath12k_dp_list_cut_nodes(&extra, &dp->rx_desc_free_list,
+					     num_free - req_entries);
+		spin_unlock_bh(&dp->rx_desc_lock);
+		list_splice_tail(&extra, used_list);
+		req_entries += n;
+		num_remain = req_entries;
+		dp->device_stats.rx_refill_topup_bufs += n;
 	}
 
 	while (num_remain > 0) {
 		skb = dev_alloc_skb(DP_RX_BUFFER_SIZE +
 				    DP_RX_BUFFER_ALIGN_SIZE);
-		if (!skb)
+		if (!skb) {
+			dp->device_stats.rx_replenish_alloc_fail++;
 			break;
+		}
 
 		if (!IS_ALIGNED((unsigned long)skb->data,
 				DP_RX_BUFFER_ALIGN_SIZE)) {
@@ -129,14 +150,18 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 		paddr = dma_map_single(dp->dev, skb->data,
 				       skb->len + skb_tailroom(skb),
 				       DMA_FROM_DEVICE);
-		if (dma_mapping_error(dp->dev, paddr))
+		if (dma_mapping_error(dp->dev, paddr)) {
+			dp->device_stats.rx_replenish_map_fail++;
 			goto fail_free_skb;
+		}
 
 		rx_desc = list_first_entry_or_null(used_list,
 						   struct ath12k_rx_desc_info,
 						   list);
-		if (!rx_desc)
+		if (!rx_desc) {
+			dp->device_stats.rx_replenish_no_desc++;
 			goto fail_dma_unmap;
+		}
 
 		rx_desc->skb = skb;
 		cookie = rx_desc->cookie;
@@ -163,6 +188,7 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 	dev_kfree_skb_any(skb);
 out:
 	ath12k_hal_srng_access_end(ab, srng);
+	dp->rx_refill_posted += req_entries - num_remain;
 
 	if (!list_empty(used_list))
 		ath12k_dp_rx_enqueue_free(dp, used_list);
@@ -173,6 +199,91 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 }
 EXPORT_SYMBOL(ath12k_dp_rx_bufs_replenish);
 
+#define ATH12K_DP_RX_REFILL_WD_MS	1000
+
+/* The refill ring is only replenished from the reap paths, one buffer for
+ * each buffer reaped. If it ever runs empty, RXDMA has no buffer to write
+ * into, nothing reaches the REO destination rings, nothing is reaped, and RX
+ * (including the EAPOL frames of every later connection) stays dead until the
+ * driver is reloaded. WCN7850 has no host2rxdma low-threshold interrupt to
+ * break that loop, so check the ring from a timer.
+ *
+ * The timer also completes the initial fill. The setup fill is bounded by the
+ * ring size, and with per-MAC buffer rings the firmware moves those buffers on
+ * into the MAC rings, so the host ring and the MAC rings would circulate only
+ * one ring's worth of buffers. Keep posting from the descriptor pool, quietly,
+ * until a pool's worth of buffers has gone into the ring.
+ */
+static void ath12k_dp_rx_refill_wd(struct timer_list *t)
+{
+	struct ath12k_dp *dp = timer_container_of(dp, t, rx_refill_wd);
+	struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
+	struct ath12k_device_dp_stats *stats = &dp->device_stats;
+	struct ath12k_base *ab = dp->ab;
+	struct hal_srng *srng;
+	LIST_HEAD(list);
+	int num_free, n;
+	bool reaped;
+	u32 posted;
+
+	if (!test_bit(ATH12K_FLAG_EXT_IRQ_ENABLED, &ab->dev_flags) ||
+	    test_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+	    test_bit(ATH12K_FLAG_RECOVERY, &ab->dev_flags))
+		goto rearm;
+
+	srng = &dp->hal->srng_list[rx_ring->refill_buf_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	num_free = ath12k_hal_srng_src_num_free(ab, srng, true);
+	posted = dp->rx_refill_posted;
+	spin_unlock_bh(&srng->lock);
+
+	/* whatever was posted since the last run came from a reap path */
+	reaped = posted != dp->rx_refill_wd_posted;
+	dp->rx_refill_wd_posted = posted;
+
+	if (dp->rx_refill_filling &&
+	    (s32)(posted - dp->rx_refill_fill_end) >= 0)
+		dp->rx_refill_filling = false;
+
+	if (num_free <= rx_ring->bufs_max / (dp->rx_refill_filling ? 8 : 2))
+		goto rearm;
+
+	n = ath12k_dp_rx_bufs_replenish(dp, rx_ring, &list, num_free);
+	dp->rx_refill_wd_posted += n;
+	stats->rx_refill_wd_runs++;
+	stats->rx_refill_wd_bufs += n;
+
+	/* Quiet during the initial fill. After it, a ring that runs low while
+	 * buffers are still reaped is only busy, and one that cannot be
+	 * refilled holds the whole pool already.
+	 */
+	if (dp->rx_refill_filling || reaped || !n)
+		goto rearm;
+
+	stats->rx_refill_wd_stalls++;
+	if (__ratelimit(&dp->rx_refill_wd_rs))
+		ath12k_warn(ab, "rx refill ring ran low with nothing reaped for %u ms: %d of %d free, posted %d (alloc fail %u, map fail %u, no desc %u, stalls %u)\n",
+			    ATH12K_DP_RX_REFILL_WD_MS, num_free,
+			    rx_ring->bufs_max, n,
+			    stats->rx_replenish_alloc_fail,
+			    stats->rx_replenish_map_fail,
+			    stats->rx_replenish_no_desc,
+			    stats->rx_refill_wd_stalls);
+
+rearm:
+	mod_timer(&dp->rx_refill_wd,
+		  jiffies + msecs_to_jiffies(ATH12K_DP_RX_REFILL_WD_MS));
+}
+
+void ath12k_dp_rx_refill_wd_stop(struct ath12k_dp *dp)
+{
+	if (!dp->rx_refill_wd_init)
+		return;
+
+	timer_shutdown_sync(&dp->rx_refill_wd);
+	dp->rx_refill_wd_init = false;
+}
+
 static int ath12k_dp_rxdma_mon_buf_ring_free(struct ath12k_base *ab,
 					     struct dp_rxdma_mon_ring *rx_ring)
 {
@@ -1592,6 +1703,7 @@ void ath12k_dp_rx_free(struct ath12k_base *ab)
 	struct dp_srng *srng;
 	int i;
 
+	ath12k_dp_rx_refill_wd_stop(dp);
 	ath12k_dp_srng_cleanup(ab, &dp->rx_refill_buf_ring.refill_buf_ring);
 
 	for (i = 0; i < ab->hw_params->num_rxdma_per_pdev; i++) {
@@ -1760,12 +1872,21 @@ int ath12k_dp_rx_alloc(struct ath12k_base *ab)
 		}
 	}
 
+	dp->rx_refill_fill_end = dp->rx_refill_posted + ATH12K_RX_DESC_COUNT(ab);
 	ret = ath12k_dp_rxdma_buf_setup(ab);
 	if (ret) {
 		ath12k_warn(ab, "failed to setup rxdma ring\n");
 		return ret;
 	}
 
+	ratelimit_state_init(&dp->rx_refill_wd_rs, 60 * HZ, 1);
+	dp->rx_refill_wd_posted = dp->rx_refill_posted;
+	dp->rx_refill_filling = true;
+	timer_setup(&dp->rx_refill_wd, ath12k_dp_rx_refill_wd, TIMER_DEFERRABLE);
+	dp->rx_refill_wd_init = true;
+	mod_timer(&dp->rx_refill_wd,
+		  jiffies + msecs_to_jiffies(ATH12K_DP_RX_REFILL_WD_MS));
+
 	return 0;
 }
 
