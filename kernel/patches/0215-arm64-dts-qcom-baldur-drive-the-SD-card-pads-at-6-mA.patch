From 84958941cf7709473cc7324916b2bde098e85b1b Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Fri, 20 Nov 2026 01:44:04 +0900
Subject: [PATCH] arm64: dts: qcom: baldur: drive the SD card pads at 6 mA

The SoC default drives the SD clock at 16 mA and the command and data
lines at 10 mA. The stock firmware drives all three at 6 mA on this
board; use the same. Some cards get data CRC errors at SDR104 (202 MHz)
and none at 100 MHz, and the drive strength is where the SD setup
differs from the stock one.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 arch/arm64/boot/dts/qcom/baldur-storage.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
index fec001e35..e6372881c 100644
--- a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
+++ b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
@@ -63,6 +63,18 @@ &sdhc_2 {
  * up for switches that pull it low.
  */
 &sdc2_default {
+	clk-pins {
+		drive-strength = <6>;
+	};
+
+	cmd-pins {
+		drive-strength = <6>;
+	};
+
+	data-pins {
+		drive-strength = <6>;
+	};
+
 	card-detect-pins {
 		/delete-property/ bias-pull-up;
 		bias-disable;
-- 
2.53.0

