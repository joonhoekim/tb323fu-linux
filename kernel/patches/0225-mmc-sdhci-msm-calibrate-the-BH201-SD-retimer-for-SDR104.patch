diff --git a/drivers/mmc/host/sd-retimer-o2.c b/drivers/mmc/host/sd-retimer-o2.c
new file mode 100644
index 000000000..1facee458
--- /dev/null
+++ b/drivers/mmc/host/sd-retimer-o2.c
@@ -0,0 +1,895 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * O2Micro/BayHub BH201/BH202 SD retimer
+ *
+ * The retimer sits between the SDHCI controller and the card and needs a
+ * card-specific TX/RX DLL calibration before UHS-I can be used.  The vendor
+ * kernel calibrates it from sdhci-msm's init_card and execute_tuning hooks;
+ * this file implements the same protocol as an mmc_host_ops wrapper.
+ *
+ * The key difference is where the phase is written.  A phase write at 202 MHz
+ * goes over the very link the bad phase breaks; a run of such writes can wedge
+ * the retimer's emulator path until the card is re-initialised.  The retimer's
+ * 100m DLL is the one used at init_card
+ * (400 kHz) and it is stable.  So this driver writes each candidate
+ * configuration at init_card time, lets the core re-enumerate the card
+ * (mmc_detect_change), and only *reads* LBA0 at 202 MHz to score it.  That
+ * matches the vendor's real recovery path: a bad phase is left by a card
+ * re-init, not by writing another phase over it.
+ *
+ * The score of a trial is real data, so the host side must be sane before the
+ * read: sdhci-msm only initializes its CM DLL and sets use_cdr (the
+ * controller's clock-data-recovery, enabled per data read) from its own
+ * execute_tuning.  A candidate read is therefore always preceded by the
+ * original host tuning; without it every 202 MHz read fails with a CRC error
+ * no matter what phase the retimer is at.
+ *
+ * Search: the 121 (sela, selb) phases at the table's own DLL voltage and drive
+ * strength.  The map is taken across re-enumerations, so its absolute phase
+ * moves with the DLL re-lock; the widest pass windows are ranked as candidates
+ * and each is verified on a fresh enumeration before one is accepted.
+ * Because of that re-lock, a phase is never trusted for longer than one
+ * enumeration either: every later SDR104 attach (a system resume powers the
+ * card off and re-initialises it) re-scores the stored phase with three LBA0
+ * reads.  That check cannot repair anything - a new phase needs a sweep, a
+ * sweep needs the card to be re-enumerated, and at that point the card is
+ * registered and may hold the mounted root filesystem - so it reports the
+ * miss and drops SDR104 for the next re-init (SDR50); the next boot
+ * calibrates again before the root is mounted.
+ * If the whole sweep fails, SDR104 is dropped and the card is re-enumerated at
+ * SDR50: the unit still boots (the vendor's own degrade path) and the map
+ * stays in the log.
+ *
+ * Emulator protocol (vendor sdhci-bayhub.c):
+ *   enter:  CMD7 arg 0, twice
+ *   read:   CMD17 arg 0, 512 bytes
+ *   write:  CMD7 arg 0, CMD24 arg 0 (512 bytes), CMD7 arg 0
+ *   exit:   CMD7 arg 0
+ *   select: CMD7 (RCA << 16)
+ *
+ * The first 64 bytes are GGC_CFG_DATA, packed six bits per byte (vendor
+ * cfg_bit_2_bt(), max bit 383).
+ *
+ * The vendor's calibration trusts the retimer's phase-status registers, but
+ * those are not usable on this board.  This driver does not use the status
+ * registers at all: at init_card it saves LBA0 as a golden block, and scores
+ * every trial by reading LBA0 through the real 202 MHz link and comparing.
+ *
+ * The init_card write always restores the card to 1-bit, deselected state,
+ * even on error: at init_card time a wedged retimer must never leave the
+ * card unusable.
+ *
+ * Ported from the Lenovo factory sdhci-bayhub.c and the TB323FU Android 17
+ * sdhci-msm.ko.  The GGC table below is the TB323FU one.
+ */
+
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/list.h>
+#include <linux/mmc/card.h>
+#include <linux/mmc/core.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/sd.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "sdhci.h"
+#include "sd-retimer-o2.h"
+
+#ifndef SD_APP_SET_CLR_CARD_DETECT
+#define SD_APP_SET_CLR_CARD_DETECT	42
+#endif
+
+#define O2_MAX_CFG_BIT		383
+#define O2_GGC_WORDS		16
+#define O2_PHASES		11
+#define O2_STAGE1_COUNT		(O2_PHASES * O2_PHASES)
+#define O2_STAGE_PHASES		0
+#define O2_STAGE_CENTRE		1
+#define O2_MAX_CAND		4
+
+struct o2_cand {
+	u8 sela, selb, run;
+};
+
+/* TB323FU (Lenovo Y700 Gen 5) GGC_CFG_DATA, from the Android 17 sdhci-msm.ko. */
+static const u32 o2_ggc_cfg[O2_GGC_WORDS] = {
+	0x07000000, 0x07364022, 0x01015412, 0x01062400,
+	0x10400076, 0x00025432, 0x01046076, 0x62011000,
+	0x31503106, 0x64141731, 0x10057513, 0x00336200,
+	0x00020006, 0x40001400, 0x12200310, 0x4A416677,
+};
+
+/* Configuration bit offsets (packed six bits per byte). */
+#define O2_SELA_200M_CFG	130
+#define O2_SELB_200M_CFG	144
+#define O2_SELB_200M_EN		184
+#define O2_INT_TUNING_200M	172
+
+struct o2_retimer {
+	struct mmc_host *mmc;
+	struct sdhci_host *host;
+	const struct mmc_host_ops *orig_ops;
+	struct mmc_host_ops ops;
+	struct list_head list;
+	bool present;
+
+	u8 base_cfg[64];	/* GGC table, packed */
+	u8 trial_cfg[64];	/* configuration written at the current init */
+	u8 golden[512];		/* LBA0 read at init_card, 400 kHz 1-bit */
+	bool golden_valid;
+	u8 cid[16];		/* the card the calibration belongs to */
+	bool cid_valid;
+
+	int def_sela, def_selb;	/* phase in the table */
+	int stage;		/* O2_STAGE_PHASES or O2_STAGE_CENTRE */
+	int trial;		/* index within the stage */
+	int sela, selb;
+	struct o2_cand cand[O2_MAX_CAND];
+	int ncand;
+	int centre_tries;	/* enumerations spent on the current candidate */
+	u16 pass_row[O2_PHASES];
+	u64 last_ns;		/* start of the previous trial, for the log */
+	bool init_done;
+	bool calib_done;
+	bool calib_failed;
+	bool stale;		/* the stored phase stopped reading at runtime */
+};
+
+static LIST_HEAD(o2_retimers);
+static DEFINE_MUTEX(o2_retimers_lock);
+
+static struct o2_retimer *o2_find(struct mmc_host *mmc)
+{
+	struct o2_retimer *o2;
+
+	mutex_lock(&o2_retimers_lock);
+	list_for_each_entry(o2, &o2_retimers, list) {
+		if (o2->mmc == mmc) {
+			mutex_unlock(&o2_retimers_lock);
+			return o2;
+		}
+	}
+	mutex_unlock(&o2_retimers_lock);
+	return NULL;
+}
+
+static int o2_cmd(struct mmc_host *mmc, u32 opcode, u32 arg, u32 flags,
+		  unsigned int retries, u32 *resp)
+{
+	struct mmc_command cmd = { };
+	int err;
+
+	cmd.opcode = opcode;
+	cmd.arg = arg;
+	cmd.flags = flags;
+
+	err = mmc_wait_for_cmd(mmc, &cmd, retries);
+	if (resp)
+		*resp = cmd.resp[0];
+	return err;
+}
+
+static int o2_data_to(struct mmc_host *mmc, u32 opcode, u32 arg, void *buf,
+		      unsigned int len, bool write, u64 timeout_ns)
+{
+	struct mmc_request mrq = { };
+	struct mmc_command cmd = { };
+	struct mmc_data data = { };
+	struct scatterlist sg;
+
+	sg_init_one(&sg, buf, len);
+
+	cmd.opcode = opcode;
+	cmd.arg = arg;
+	cmd.flags = MMC_RSP_R1 | MMC_CMD_ADTC;
+
+	data.blksz = len;
+	data.blocks = 1;
+	data.flags = write ? MMC_DATA_WRITE : MMC_DATA_READ;
+	data.timeout_ns = timeout_ns;
+	data.sg = &sg;
+	data.sg_len = 1;
+
+	mrq.cmd = &cmd;
+	mrq.data = &data;
+
+	mmc_wait_for_req(mmc, &mrq);
+
+	if (cmd.error)
+		return cmd.error;
+	if (data.error)
+		return data.error;
+	return 0;
+}
+
+static int o2_data(struct mmc_host *mmc, u32 opcode, u32 arg, void *buf,
+		   unsigned int len, bool write)
+{
+	return o2_data_to(mmc, opcode, arg, buf, len, write,
+			  1000 * 1000 * 1000);
+}
+
+static int o2_select(struct mmc_host *mmc, struct mmc_card *card, bool select)
+{
+	if (select)
+		return o2_cmd(mmc, MMC_SELECT_CARD, card->rca << 16,
+			      MMC_RSP_R1B | MMC_CMD_AC, 0, NULL);
+	return o2_cmd(mmc, MMC_SELECT_CARD, 0,
+		      MMC_RSP_NONE | MMC_CMD_AC, 3, NULL);
+}
+
+static int o2_app_cmd(struct mmc_host *mmc, struct mmc_card *card, u32 opcode,
+		      u32 arg, u32 flags)
+{
+	int err;
+
+	err = o2_cmd(mmc, MMC_APP_CMD, card->rca << 16,
+		     MMC_RSP_R1 | MMC_CMD_AC, 0, NULL);
+	if (err)
+		return err;
+	return o2_cmd(mmc, opcode, arg, flags, 0, NULL);
+}
+
+static int o2_app_data(struct mmc_host *mmc, struct mmc_card *card, u32 opcode,
+		       u32 arg, void *buf, unsigned int len)
+{
+	int err;
+
+	err = o2_cmd(mmc, MMC_APP_CMD, card->rca << 16,
+		     MMC_RSP_R1 | MMC_CMD_AC, 0, NULL);
+	if (err)
+		return err;
+	return o2_data(mmc, opcode, arg, buf, len, false);
+}
+
+/* Configuration table: six bits per byte, reversed from bit 383. */
+static void o2_cfg_bit2bt(int tar, int *byt, int *bit)
+{
+	static const u8 map[6] = { 6, 5, 4, 2, 1, 0 };
+	int t = O2_MAX_CFG_BIT - tar;
+
+	*byt = t / 6;
+	*bit = map[t % 6];
+}
+
+static void o2_cfg_write_bits(u8 *cfg, u32 ofs, u32 mask, u32 value)
+{
+	u32 v = value & mask;
+	int i = 0, byt, bit;
+
+	do {
+		o2_cfg_bit2bt(ofs + i, &byt, &bit);
+		if (v & 1)
+			cfg[byt] |= 1 << bit;
+		else
+			cfg[byt] &= ~(1 << bit);
+		i++;
+		v >>= 1;
+		mask >>= 1;
+	} while (mask);
+}
+
+static u32 o2_cfg_read_bits(const u8 *cfg, u32 ofs, u32 mask)
+{
+	u32 v = 0;
+	int i = 0, byt, bit;
+
+	do {
+		o2_cfg_bit2bt(ofs + i, &byt, &bit);
+		if (cfg[byt] & (1 << bit))
+			v |= 1u << i;
+		i++;
+		mask >>= 1;
+	} while (mask);
+	return v;
+}
+
+/*
+ * Write one configuration block through the init_card path: one CMD7(0),
+ * CMD24, one CMD7(0), host back to 1 bit.  This is the vendor
+ * bht_update_cfg(); it runs at 400 kHz where the retimer's 100m DLL is in
+ * use, so it is independent of the 200m phase being tested.
+ */
+static int o2_write_cfg(struct o2_retimer *o2, struct mmc_card *card,
+			const u8 *cfg)
+{
+	struct sdhci_host *host = o2->host;
+	struct mmc_host *mmc = host->mmc;
+	u8 *buf;
+	int err;
+
+	buf = kzalloc(512, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memcpy(buf, cfg, 64);
+
+	sdhci_set_bus_width(host, MMC_BUS_WIDTH_4);
+	sdhci_reset(host, SDHCI_RESET_CMD | SDHCI_RESET_DATA);
+
+	err = o2_select(mmc, NULL, false);
+	if (err) {
+		dev_err(mmc->parent, "BH201: CMD7(0) before write: %d\n", err);
+		/* Never write while the card may still be selected. */
+		sdhci_set_bus_width(host, MMC_BUS_WIDTH_1);
+		kfree(buf);
+		return err;
+	}
+
+	err = o2_data(mmc, MMC_WRITE_BLOCK, 0, buf, 512, true);
+	if (err)
+		dev_err(mmc->parent, "BH201: CMD24 write: %d\n", err);
+
+	if (o2_select(mmc, NULL, false))
+		dev_err(mmc->parent, "BH201: CMD7(0) after write failed\n");
+
+	sdhci_set_bus_width(host, MMC_BUS_WIDTH_1);
+	kfree(buf);
+	return err;
+}
+
+/*
+ * Put the card back where the core expects it at init_card time: CSD read,
+ * selected, SCR and switch read, 1-bit bus, CD pull-up off, deselected.
+ * This is the vendor bht_load() tail; without it the core's CMD3 after
+ * init_card can fail.
+ */
+static void o2_restore_card(struct o2_retimer *o2, struct mmc_card *card)
+{
+	struct mmc_host *mmc = o2->host->mmc;
+	u8 *buf;
+	int err;
+
+	buf = kzalloc(64, GFP_KERNEL);
+	if (!buf)
+		return;
+
+	err = o2_cmd(mmc, MMC_SEND_CSD, card->rca << 16,
+		     MMC_RSP_R2 | MMC_CMD_AC, 0, NULL);
+	if (err)
+		dev_dbg(mmc->parent, "BH201: CMD9: %d\n", err);
+
+	if (o2_select(mmc, card, true))
+		dev_dbg(mmc->parent, "BH201: select for restore failed\n");
+
+	err = o2_app_data(mmc, card, SD_APP_SEND_SCR, 0, buf, 8);
+	if (err)
+		dev_dbg(mmc->parent, "BH201: ACMD51: %d\n", err);
+
+	err = o2_data(mmc, SD_SWITCH, 0x00FFFFFF, buf, 64, false);
+	if (err)
+		dev_dbg(mmc->parent, "BH201: CMD6: %d\n", err);
+
+	err = o2_app_cmd(mmc, card, SD_APP_SET_BUS_WIDTH, SD_BUS_WIDTH_1,
+			 MMC_RSP_R1 | MMC_CMD_AC);
+	if (err)
+		dev_dbg(mmc->parent, "BH201: ACMD6: %d\n", err);
+
+	err = o2_app_cmd(mmc, card, SD_APP_SET_CLR_CARD_DETECT, 0,
+			 MMC_RSP_R1 | MMC_CMD_AC);
+	if (err)
+		dev_dbg(mmc->parent, "BH201: ACMD42: %d\n", err);
+
+	if (o2_select(mmc, card, false))
+		dev_dbg(mmc->parent, "BH201: final deselect failed\n");
+
+	kfree(buf);
+}
+
+/*
+ * Save LBA0 at 400 kHz / 1 bit as the golden block for the calibration.
+ * The card is deselected at this point; select it, read, deselect so the
+ * core's CMD3 right after init_card still sees the expected state.
+ */
+static void o2_read_golden(struct o2_retimer *o2, struct mmc_card *card)
+{
+	struct mmc_host *mmc = o2->host->mmc;
+
+	if (o2_select(mmc, card, true))
+		return;
+
+	if (!o2_data(mmc, MMC_READ_SINGLE_BLOCK, 0, o2->golden, 512, false))
+		o2->golden_valid = true;
+	else
+		dev_err(mmc->parent, "BH201: golden LBA0 read failed\n");
+
+	o2_select(mmc, card, false);
+}
+
+/*
+ * Build the configuration for a (sela, selb) trial.  Only the 200m fields
+ * move: they are the ones in use at 202 MHz, while the 100m DLL keeps the
+ * table's own phase and its internal tuning.  That matters when SDR104 is
+ * dropped (the boot sweep failed, or a resume found the stored phase stale):
+ * the next enumeration then runs SDR50 on exactly the vendor table setup that
+ * this board already ran with, not on an unvalidated 100 MHz phase.
+ */
+static void o2_make_cfg(struct o2_retimer *o2, u8 *cfg, int sela, int selb)
+{
+	memcpy(cfg, o2->base_cfg, sizeof(o2->base_cfg));
+
+	o2_cfg_write_bits(cfg, O2_SELA_200M_CFG, 0xf, sela);
+	o2_cfg_write_bits(cfg, O2_SELB_200M_CFG, 0xf, selb);
+	o2_cfg_write_bits(cfg, O2_SELB_200M_EN, 1, 1);
+	o2_cfg_write_bits(cfg, O2_INT_TUNING_200M, 1, 0);
+}
+
+/*
+ * Point the driver at a trial.  The caller then fails the current init with
+ * mmc_detect_change(), which re-enumerates the card at 400 kHz and writes the
+ * new configuration in init_card.  That is the only reliable way to leave a
+ * bad 200m phase.
+ */
+static void o2_set_trial(struct o2_retimer *o2, int stage, int trial)
+{
+	int sela, selb;
+
+	o2->stage = stage;
+	o2->trial = trial;
+
+	if (stage == O2_STAGE_PHASES) {
+		sela = trial / O2_PHASES;
+		selb = trial % O2_PHASES;
+	} else {
+		sela = o2->cand[trial].sela;
+		selb = o2->cand[trial].selb;
+		o2->centre_tries = 0;
+	}
+
+	o2->sela = sela;
+	o2->selb = selb;
+	o2_make_cfg(o2, o2->trial_cfg, sela, selb);
+}
+
+/*
+ * Rank the pass windows: every unbroken run of passing selb cells in a sela
+ * row is a candidate, widest first.  A single centre is not enough because
+ * the retimer's DLL re-locks at every card power-up, so the whole map moves:
+ * the window that was best during the sweep may already be stale when the
+ * final phase is written, and the next one has to be tried.  This is the
+ * vendor's chk_phase_window() rule plus a fallback list.
+ */
+static int o2_build_candidates(struct o2_retimer *o2)
+{
+	struct {
+		u8 sela, selb, run;
+	} all[O2_PHASES * 6];
+	int n = 0, sela, selb, i, j;
+
+	for (sela = 0; sela < O2_PHASES; sela++) {
+		int run = 0, start = 0;
+
+		for (selb = 0; selb <= O2_PHASES; selb++) {
+			bool pass = selb < O2_PHASES &&
+				    (o2->pass_row[sela] & (1 << selb));
+
+			if (pass) {
+				if (!run)
+					start = selb;
+				run++;
+			} else if (run) {
+				if (n < ARRAY_SIZE(all)) {
+					all[n].sela = sela;
+					all[n].selb = start + (run - 1) / 2;
+					all[n].run = run;
+					n++;
+				}
+				run = 0;
+			}
+		}
+	}
+
+	o2->ncand = 0;
+	for (i = 0; i < O2_MAX_CAND; i++) {
+		int best = -1;
+
+		for (j = 0; j < n; j++) {
+			if (all[j].run && (best < 0 || all[j].run > all[best].run))
+				best = j;
+		}
+		if (best < 0)
+			break;
+		o2->cand[o2->ncand].sela = all[best].sela;
+		o2->cand[o2->ncand].selb = all[best].selb;
+		o2->cand[o2->ncand].run = all[best].run;
+		o2->ncand++;
+		all[best].run = 0;
+	}
+
+	return o2->ncand;
+}
+
+static void o2_dump_map(struct o2_retimer *o2, struct mmc_host *mmc)
+{
+	int sela;
+
+	for (sela = 0; sela < O2_PHASES; sela++)
+		dev_info(mmc->parent, "BH201 map: sela %2d selb 0x%03x\n",
+			 sela, o2->pass_row[sela]);
+}
+
+/*
+ * The vendor's own degrade path: drop UHS and continue at high speed.  Here
+ * only SDR104 goes; SDR50 (100 MHz, the retimer's 100m DLL) still works, so
+ * the unit boots and the failed map stays reachable in the log.
+ */
+static int o2_calib_fail(struct o2_retimer *o2, struct mmc_host *mmc,
+			 const char *why)
+{
+	dev_err(mmc->parent,
+		"BH201 calib: %s; no usable 202 MHz phase, dropping SDR104\n",
+		why);
+	o2->calib_failed = true;
+	/*
+	 * The SDR50 re-enumeration must not inherit the last trial's phase:
+	 * put the table's own phase back, the one the board boots with.
+	 */
+	o2->sela = o2->def_sela;
+	o2->selb = o2->def_selb;
+	o2_make_cfg(o2, o2->trial_cfg, o2->def_sela, o2->def_selb);
+	mmc->caps &= ~MMC_CAP_UHS_SDR104;
+	/* Only the boot attach may re-enumerate; see o2_execute_tuning(). */
+	if (!mmc->card)
+		mmc_detect_change(mmc, 0);
+	return -EIO;
+}
+
+static int o2_calib_next(struct o2_retimer *o2, struct mmc_host *mmc,
+			 const char *why)
+{
+	if (o2->stage == O2_STAGE_PHASES) {
+		if (o2->trial + 1 < O2_STAGE1_COUNT) {
+			o2_set_trial(o2, O2_STAGE_PHASES, o2->trial + 1);
+			mmc_detect_change(mmc, 0);
+			return -EIO;
+		}
+		o2_dump_map(o2, mmc);
+		if (!o2_build_candidates(o2))
+			return o2_calib_fail(o2, mmc, "the phase sweep is empty");
+		dev_info(mmc->parent,
+			 "BH201 calib: best window phase %d/%d (run %d), %d candidates\n",
+			 o2->cand[0].sela, o2->cand[0].selb, o2->cand[0].run,
+			 o2->ncand);
+		o2_set_trial(o2, O2_STAGE_CENTRE, 0);
+		mmc_detect_change(mmc, 0);
+		return -EIO;
+	}
+
+	/* The centre failed: try it once more, the DLL lock point moves. */
+	if (o2->centre_tries < 1) {
+		o2->centre_tries++;
+		dev_info(mmc->parent,
+			 "BH201 calib: candidate %d phase %d/%d did not read, retrying\n",
+			 o2->trial, o2->sela, o2->selb);
+		mmc_detect_change(mmc, 0);
+		return -EIO;
+	}
+
+	/* Still bad: take the next widest window. */
+	if (o2->trial + 1 < o2->ncand) {
+		dev_info(mmc->parent,
+			 "BH201 calib: candidate %d failed, trying %d\n",
+			 o2->trial, o2->trial + 1);
+		o2_set_trial(o2, O2_STAGE_CENTRE, o2->trial + 1);
+		mmc_detect_change(mmc, 0);
+		return -EIO;
+	}
+
+	return o2_calib_fail(o2, mmc, why);
+}
+
+static int o2_calib_step(struct o2_retimer *o2, struct mmc_host *mmc, int score)
+{
+	if (o2->stage == O2_STAGE_PHASES) {
+		if (score >= 2)
+			o2->pass_row[o2->sela] |= 1 << o2->selb;
+		return o2_calib_next(o2, mmc, "phase scanned");
+	}
+
+	if (score >= 2) {
+		o2->calib_done = true;
+		dev_info(mmc->parent,
+			 "BH201 calib: done, phase %d/%d score %d/3\n",
+			 o2->sela, o2->selb, score);
+		return 0;
+	}
+
+	return o2_calib_next(o2, mmc, "the centre phase did not read");
+}
+
+/*
+ * Score the stored phase with real data at 202 MHz: three LBA0 reads, each
+ * accepted only if it completes without a command/data error and matches the
+ * golden block.  Two of the three make the phase usable: the first read after
+ * an enumeration can fail while the retimer's DLL and the host's CDR settle,
+ * and one transient must not erase a whole phase.
+ *
+ * host_rc is the original host tuning of this same enumeration; a failed
+ * tuning means the CMD line is not usable either, so the phase scores zero
+ * however the data read goes.  No phase writes happen at 202 MHz.
+ */
+static int o2_score_lba0(struct o2_retimer *o2, struct mmc_host *mmc, int host_rc)
+{
+	u8 *buf;
+	int i, data_ok = 0;
+
+	if (host_rc || !o2->golden_valid)
+		return 0;
+
+	buf = kzalloc(512, GFP_KERNEL);
+	if (!buf)
+		return 0;
+
+	for (i = 0; i < 3; i++) {
+		memset(buf, 0, 512);
+		if (!o2_data_to(mmc, MMC_READ_SINGLE_BLOCK, 0, buf, 512, false,
+				100 * 1000 * 1000) &&
+		    !memcmp(buf, o2->golden, 512))
+			data_ok++;
+	}
+	kfree(buf);
+
+	return data_ok;
+}
+
+static int o2_data_calib(struct o2_retimer *o2, struct mmc_host *mmc, int host_rc)
+{
+	u64 now = ktime_get_ns();
+	int score = o2_score_lba0(o2, mmc, host_rc);
+
+	dev_dbg(mmc->parent,
+		"BH201 calib: stage %d phase %d/%d host %d score %d/3 %llu ms\n",
+		o2->stage, o2->sela, o2->selb, host_rc, score,
+		(unsigned long long)(now - o2->last_ns) / 1000000);
+	o2->last_ns = now;
+
+	return o2_calib_step(o2, mmc, score);
+}
+
+static int o2_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	struct o2_retimer *o2 = o2_find(mmc);
+	bool boot = !mmc->card;
+	int host_rc;
+
+	if (!o2)
+		return 0;
+	if (!o2->orig_ops || !o2->orig_ops->execute_tuning)
+		return 0;
+	if (mmc->ios.timing != MMC_TIMING_UHS_SDR104 ||
+	    mmc->ios.clock <= 100000000)
+		return o2->orig_ops->execute_tuning(mmc, opcode);
+	if (o2->calib_failed)
+		return o2->orig_ops->execute_tuning(mmc, opcode);
+
+	/*
+	 * The host tuning must run first even though its result is not the
+	 * score: it initializes the CM DLL and sets use_cdr, and sdhci-msm
+	 * enables the controller's clock-data-recovery on a data read only
+	 * when that is set.  Without it every 202 MHz data read fails with a
+	 * CRC error whatever phase the retimer is at.
+	 */
+	host_rc = o2->orig_ops->execute_tuning(mmc, opcode);
+
+	/*
+	 * A sweep needs the card to be re-enumerated between trials.  That is
+	 * safe only while the card is not registered yet (the boot attach, or
+	 * an attach after the card was removed): a failed attach leaves no
+	 * block device behind.  A system resume re-initialises the registered
+	 * card in place, and there a sweep would delete the block device under
+	 * the mounted root filesystem.  So a resume only checks the stored
+	 * phase; on a miss SDR104 is dropped so the next re-init comes up at
+	 * SDR50, and the next boot calibrates again.
+	 */
+	if (!boot) {
+		if (o2->calib_done && !host_rc &&
+		    o2_score_lba0(o2, mmc, 0) >= 2) {
+			if (o2->stale) {
+				dev_info(mmc->parent,
+					 "BH201 calib: phase %d/%d reads again\n",
+					 o2->sela, o2->selb);
+				o2->stale = false;
+			}
+			return 0;
+		}
+
+		if (!o2->stale)
+			dev_err(mmc->parent,
+				"BH201 calib: phase %d/%d no longer reads after the card was re-initialised (host %d); SDR50 from the next re-init, 202 MHz returns at the next boot\n",
+				o2->sela, o2->selb, host_rc);
+		o2->stale = true;
+		mmc->caps &= ~MMC_CAP_UHS_SDR104;
+		return host_rc;
+	}
+
+	if (!o2->present || !o2->golden_valid)
+		return o2_calib_fail(o2, mmc,
+				     "the retimer did not take the configuration");
+
+	return o2_data_calib(o2, mmc, host_rc);
+}
+
+static void o2_hw_init(struct o2_retimer *o2, struct mmc_card *card)
+{
+	struct mmc_host *mmc = o2->host->mmc;
+	struct device *dev = mmc->parent;
+	u32 inject[O2_GGC_WORDS];
+	u32 resp = 0;
+	int err;
+
+	/* init_card runs before the core's CMD3: get the RCA ourselves. */
+	err = o2_cmd(mmc, SD_SEND_RELATIVE_ADDR, 0,
+		     MMC_RSP_R6 | MMC_CMD_BCR, 3, &resp);
+	if (err || !(resp >> 16)) {
+		dev_warn(dev, "BH201: CMD3 %s (%d), leaving the card to the core\n",
+			 err ? "failed" : "returned RCA 0", err);
+		return;
+	}
+	card->rca = resp >> 16;
+	dev_dbg(dev, "BH201 init: rca %04x\n", card->rca);
+
+	/*
+	 * A different card invalidates the whole calibration: the phase
+	 * belongs to the card, not to the host.  The same card on a resume or
+	 * a re-enumeration keeps its calibrated phase.
+	 */
+	if (o2->cid_valid && memcmp(o2->cid, card->raw_cid, sizeof(o2->cid))) {
+		dev_info(dev, "BH201: card changed, restarting the calibration\n");
+		o2->present = false;
+		o2->init_done = false;
+		o2->calib_done = false;
+		o2->calib_failed = false;
+		o2->golden_valid = false;
+		o2->stale = false;
+		o2->ncand = 0;
+		o2->centre_tries = 0;
+		memset(o2->pass_row, 0, sizeof(o2->pass_row));
+	}
+	memcpy(o2->cid, card->raw_cid, sizeof(o2->cid));
+	o2->cid_valid = true;
+
+	if (!o2->init_done) {
+		o2->init_done = true;
+		o2_set_trial(o2, 0, 0);
+		dev_info(dev, "BH201 calib: start, default phase %d/%d\n",
+			 o2->def_sela, o2->def_selb);
+	}
+
+	if (o2_select(mmc, NULL, false))
+		dev_dbg(dev, "BH201: initial deselect failed\n");
+
+	memcpy(inject, o2_ggc_cfg, sizeof(inject));
+	inject[1] = 0x07364032;
+	inject[11] = 0x77316200;
+	inject[12] = 0x00725777;
+	err = o2_write_cfg(o2, card, (const u8 *)inject);
+	if (!err)
+		err = o2_write_cfg(o2, card, o2->trial_cfg);
+	o2->present = !err;
+	if (err)
+		dev_err(dev, "BH201 init: trial write failed (stage %d phase %d/%d)\n",
+			o2->stage, o2->sela, o2->selb);
+	else
+		dev_dbg(dev, "BH201 init: stage %d phase %d/%d written\n",
+			o2->stage, o2->sela, o2->selb);
+
+	if (!o2->golden_valid)
+		o2_read_golden(o2, card);
+	o2_restore_card(o2, card);
+}
+
+static void o2_init_card(struct mmc_host *mmc, struct mmc_card *card)
+{
+	struct o2_retimer *o2 = o2_find(mmc);
+
+	if (!o2)
+		return;
+
+	if (o2->orig_ops && o2->orig_ops->init_card)
+		o2->orig_ops->init_card(mmc, card);
+
+	o2_hw_init(o2, card);
+}
+
+/*
+ * Unlink this retimer from the lookup table and give the host its original
+ * ops back.  Idempotent: it runs from sdhci_msm_remove() and, as a devres
+ * action, when the device goes away after a failed probe.
+ */
+static void o2_unlink(struct o2_retimer *o2)
+{
+	struct mmc_host *mmc = o2->mmc;
+
+	mutex_lock(&o2_retimers_lock);
+	if (!list_empty(&o2->list))
+		list_del_init(&o2->list);
+	mutex_unlock(&o2_retimers_lock);
+
+	if (mmc->ops == &o2->ops)
+		mmc->ops = o2->orig_ops;
+}
+
+static void o2_release(void *data)
+{
+	o2_unlink(data);
+}
+
+void o2_retimer_install(struct sdhci_host *host)
+{
+	struct mmc_host *mmc = host->mmc;
+	struct device_node *np;
+	struct o2_retimer *o2;
+
+	if (!mmc || !mmc->ops || !mmc->parent)
+		return;
+
+	np = mmc->parent->of_node;
+	if (!np || !of_property_read_bool(np, "lenovo,bh201-retimer"))
+		return;
+
+	o2 = devm_kzalloc(mmc->parent, sizeof(*o2), GFP_KERNEL);
+	if (!o2)
+		return;
+
+	o2->mmc = mmc;
+	o2->host = host;
+
+	memcpy(o2->base_cfg, o2_ggc_cfg, sizeof(o2->base_cfg));
+	memcpy(o2->trial_cfg, o2_ggc_cfg, sizeof(o2->trial_cfg));
+	o2->def_sela = o2_cfg_read_bits(o2->base_cfg, O2_SELA_200M_CFG, 0xf);
+	o2->def_selb = o2_cfg_read_bits(o2->base_cfg, O2_SELB_200M_CFG, 0xf);
+	o2->last_ns = ktime_get_ns();
+	INIT_LIST_HEAD(&o2->list);
+
+	o2->orig_ops = mmc->ops;
+	o2->ops = *mmc->ops;
+	o2->ops.init_card = o2_init_card;
+	o2->ops.execute_tuning = o2_execute_tuning;
+
+	mutex_lock(&o2_retimers_lock);
+	list_add_tail(&o2->list, &o2_retimers);
+	mutex_unlock(&o2_retimers_lock);
+	mmc->ops = &o2->ops;
+
+	/*
+	 * This runs before sdhci_add_host(); if that fails, the mmc_host and
+	 * this structure are freed by devres while the list entry would still
+	 * point at them.  The action unlinks it at the latest.
+	 */
+	if (devm_add_action_or_reset(mmc->parent, o2_release, o2)) {
+		dev_err(mmc->parent, "BH201: cannot register the cleanup action\n");
+		return;
+	}
+
+	dev_info(mmc->parent, "BH201 retimer enabled (ops wrapped), default phase %d/%d\n",
+		 o2->def_sela, o2->def_selb);
+}
+
+/*
+ * Called before the host is torn down.  init_card and execute_tuning run
+ * under the mmc core's host claim, so the calibration state needs no lock of
+ * its own; the list lock only protects the lookup table.
+ */
+void o2_retimer_uninstall(struct sdhci_host *host)
+{
+	struct o2_retimer *o2, *tmp;
+
+	mutex_lock(&o2_retimers_lock);
+	list_for_each_entry_safe(o2, tmp, &o2_retimers, list) {
+		if (o2->mmc != host->mmc)
+			continue;
+		list_del_init(&o2->list);
+		mutex_unlock(&o2_retimers_lock);
+		if (host->mmc->ops == &o2->ops)
+			host->mmc->ops = o2->orig_ops;
+		return;
+	}
+	mutex_unlock(&o2_retimers_lock);
+}
