 drivers/thermal/qcom/qcom-spmi-adc-tm5-gen3.c |  19 +-
 include/linux/iio/adc/qcom-adc5-gen3-common.h |  44 ++-
 include/linux/iio/adc/qcom-vadc-common.h      |   6 +
 10 files changed, 1013 insertions(+), 56 deletions(-)
