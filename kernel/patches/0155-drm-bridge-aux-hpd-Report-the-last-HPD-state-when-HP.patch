From b95a318a98b6636e86850fc9e66155a8fadf46a8 Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sat, 7 Nov 2026 00:49:55 +0000
Subject: [PATCH] drm/bridge: aux-hpd: Report the last HPD state when HPD is
 enabled

drm_bridge_hpd_notify() drops the event when no callback is registered.
The pmic_glink altmode driver can report a DisplayPort sink before the
DP controller enables HPD on the bridge chain: when the altmode driver
probes late, the firmware sends the current state right away, and the
DP controller binds only after the HPD bridge has been added. The sink
is then not detected until it is plugged in again.

Store the last reported state and report it again from .hpd_enable.

Seen on the Lenovo Y700 Gen 5 (TB323FU, Kaanapali) with a monitor
attached at boot and the USB controller, which the altmode driver waits
for as its mode switch, built as a module.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/gpu/drm/bridge/aux-hpd-bridge.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/gpu/drm/bridge/aux-hpd-bridge.c b/drivers/gpu/drm/bridge/aux-hpd-bridge.c
index a2e525aa57..6ec9f75259 100644
--- a/drivers/gpu/drm/bridge/aux-hpd-bridge.c
+++ b/drivers/gpu/drm/bridge/aux-hpd-bridge.c
@@ -18,6 +18,9 @@ static DEFINE_IDA(drm_aux_hpd_bridge_ida);
 struct drm_aux_hpd_bridge_data {
 	struct drm_bridge bridge;
 	struct device *dev;
+	/* serializes storing or replaying the status with its notification */
+	struct mutex lock;
+	enum drm_connector_status status;
 };
 
 static void drm_aux_hpd_bridge_release(struct device *dev)
@@ -154,6 +157,8 @@ void drm_aux_hpd_bridge_notify(struct device *dev, enum drm_connector_status sta
 	if (!data)
 		return;
 
+	guard(mutex)(&data->lock);
+	data->status = status;
 	drm_bridge_hpd_notify(&data->bridge, status);
 }
 EXPORT_SYMBOL_GPL(drm_aux_hpd_bridge_notify);
@@ -165,17 +170,29 @@ static int drm_aux_hpd_bridge_attach(struct drm_bridge *bridge,
 	return flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR ? 0 : -EINVAL;
 }
 
+static void drm_aux_hpd_bridge_hpd_enable(struct drm_bridge *bridge)
+{
+	struct drm_aux_hpd_bridge_data *data =
+		container_of(bridge, struct drm_aux_hpd_bridge_data, bridge);
+
+	guard(mutex)(&data->lock);
+	if (data->status != connector_status_unknown)
+		drm_bridge_hpd_notify(bridge, data->status);
+}
+
 static const struct drm_bridge_funcs drm_aux_hpd_bridge_funcs = {
 	.atomic_create_state = drm_atomic_helper_bridge_create_state,
 	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
 	.attach	= drm_aux_hpd_bridge_attach,
+	.hpd_enable = drm_aux_hpd_bridge_hpd_enable,
 };
 
 static int drm_aux_hpd_bridge_probe(struct auxiliary_device *auxdev,
 				    const struct auxiliary_device_id *id)
 {
 	struct drm_aux_hpd_bridge_data *data;
+	int ret;
 
 	data = devm_drm_bridge_alloc(&auxdev->dev,
 				     struct drm_aux_hpd_bridge_data, bridge,
@@ -184,6 +201,10 @@ static int drm_aux_hpd_bridge_probe(struct auxiliary_device *auxdev,
 		return PTR_ERR(data);
 
 	data->dev = &auxdev->dev;
+	data->status = connector_status_unknown;
+	ret = devm_mutex_init(data->dev, &data->lock);
+	if (ret)
+		return ret;
 	data->bridge.of_node = dev_get_platdata(data->dev);
 	data->bridge.ops = DRM_BRIDGE_OP_HPD;
 	data->bridge.type = id->driver_data;
-- 
2.43.0

