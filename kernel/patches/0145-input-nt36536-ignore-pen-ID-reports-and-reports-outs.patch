From 1974851383b1beba5e2abdd3b34fdfe7cbdc3738 Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Mon, 2 Nov 2026 00:13:27 +0000
Subject: [PATCH 145/146] input: nt36536: ignore pen ID reports and reports
 outside the axes

The firmware reports the pen ID with format id 0xF1 when the pen is
lifted, as it reports the pen MAC address with 0xF0. The driver logged
"Unknown pen format id!" for every such report. Skip 0xF1 as 0xF0 is
skipped; neither carries pen data.

Also drop pen data whose position lies outside the axes, as the touch
reports already do, so that a report filled with 0xFF never reaches
userspace as a full-pressure tap in the corner.

Link: https://github.com/joonhoekim/tb323fu-linux/issues/16
Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/input/touchscreen/nt36536/nt36xxx.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/input/touchscreen/nt36536/nt36xxx.c b/drivers/input/touchscreen/nt36536/nt36xxx.c
index d198b60b8f..eb6d32a126 100644
--- a/drivers/input/touchscreen/nt36536/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36536/nt36xxx.c
@@ -1016,6 +1016,8 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 				// report pen data
 				pen_x = (uint32_t)(point_data[67] << 8) + (uint32_t)(point_data[68]);
 				pen_y = (uint32_t)(point_data[69] << 8) + (uint32_t)(point_data[70]);
+				if ((pen_x > ts->abs_x_max) || (pen_y > ts->abs_y_max))
+					goto XFER_ERROR;
 				pen_pressure = (uint32_t)(point_data[71] << 8) + (uint32_t)(point_data[72]);
 				pen_tilt_x = (int32_t)point_data[73];
 				pen_tilt_y = (int32_t)point_data[74];
@@ -1038,8 +1040,8 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 				input_report_key(ts->pen_input_dev, BTN_STYLUS2, pen_btn2);
 				// TBD: pen battery event report
 				// NVT_LOG("pen_battery=%d\n", pen_battery);
-			} else if (pen_format_id == 0xF0) {
-				// report Pen ID
+			} else if (pen_format_id == 0xF0 || pen_format_id == 0xF1) {
+				// pen MAC address, pen ID
 			} else {
 				NVT_ERR("Unknown pen format id!\n");
 				goto XFER_ERROR;
-- 
