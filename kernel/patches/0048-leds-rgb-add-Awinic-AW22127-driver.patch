+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW22127 RGB LED driver
+ *
+ * The AW22127 is an LED matrix driver with a small MCU running a program
+ * kept in the chip's own flash. Lighting effects are commands to that MCU:
+ * a byte stream fed through the TASK1 mailbox (REG_MCUCTR = 0x07, then one
+ * REG_TASK1 write per byte) and started with REG_TASK0. Register protocol
+ * from Awinic's GPL leds-aw22xxx.c; command layout from the effect files of
+ * the Lenovo Legion Tab Y700 (5th gen) vendor stack.
+ *
+ * All LEDs are exposed as one multicolor LED; off holds the chip in reset.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/led-class-multicolor.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+
+#define AW22127_REG_CHIPID	0x00
+#define AW22127_REG_SRST	0x01
+#define AW22127_REG_GCR		0x02
+#define AW22127_REG_MCUCTR	0x04
+#define AW22127_REG_TASK0	0x05
+#define AW22127_REG_TASK1	0x06
+#define AW22127_REG_INTEN	0x09
+#define AW22127_REG_PST		0x0c
+#define AW22127_REG_PAGE	0xff
+
+#define AW22127_CHIPID		0x27
+#define AW22127_SRST_RESET	0x55
+#define AW22127_GCR_CHIPEN	BIT(0)
+#define AW22127_MCUCTR_MAILBOX	0x07
+
+/*
+ * "All LEDs one colour, in steps": this header, then per step the duration
+ * in ms (big endian), the brightness at its start and at its end, and R, G,
+ * B. The MCU ramps linearly within a step and loops over the steps.
+ */
+static const u8 aw22127_cmd_hdr[] = {
+	0x00, 0x80, 0x01, 0x01, 0x07, 0x00, 0x00, 0x01, 0x01, 0x00,
+	0x00, 0x00, 0x01, 0x09, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
+};
+
+#define AW22127_CMD_NSTEPS	14
+#define AW22127_STEP_LEN	7
+#define AW22127_MAX_STEPS	16
+#define AW22127_CMD_MAX		(sizeof(aw22127_cmd_hdr) + \
+				 AW22127_MAX_STEPS * AW22127_STEP_LEN)
+#define AW22127_STATIC_MS	500
+
+struct aw22127_step {
+	u16 ms;
+	u8 from;
+	u8 to;
+};
+
+struct aw22127 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *reset;
+	struct led_classdev_mc mc;
+	struct mc_subled subled[3];
+	struct mutex lock;	/* the chip, on, cmd */
+	bool on;
+	u8 cmd[AW22127_CMD_MAX];
+	size_t cmd_len;
+};
+
+static const struct regmap_config aw22127_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static void aw22127_power(struct aw22127 *aw, bool on)
+{
+	/* reset-gpios is active low: deasserted = running */
+	gpiod_set_value_cansleep(aw->reset, !on);
+	if (on)
+		usleep_range(2000, 3000);
+}
+
+static int aw22127_play(struct aw22127 *aw, const u8 *cmd, size_t len)
+{
+	struct regmap *rm = aw->regmap;
+	size_t i;
+	int ret;
+
+	ret = regmap_write(rm, AW22127_REG_PAGE, 0);
+	ret = ret ?: regmap_write(rm, AW22127_REG_GCR, AW22127_GCR_CHIPEN);
+	if (ret)
+		return ret;
+	if (!aw->on)
+		usleep_range(2000, 3000);
+
+	ret = regmap_write(rm, AW22127_REG_PST, 0);
+	ret = ret ?: regmap_write(rm, AW22127_REG_TASK0, 0x01);
+	ret = ret ?: regmap_write(rm, AW22127_REG_MCUCTR, 0x01);
+	ret = ret ?: regmap_write(rm, AW22127_REG_INTEN, 0x01);
+	ret = ret ?: regmap_write(rm, AW22127_REG_MCUCTR, 0x03);
+	for (i = 0; !ret && i < len; i++) {
+		if (i)
+			ret = regmap_write(rm, AW22127_REG_MCUCTR,
+					   AW22127_MCUCTR_MAILBOX);
+		ret = ret ?: regmap_write(rm, AW22127_REG_TASK1, cmd[i]);
+	}
+	ret = ret ?: regmap_write(rm, AW22127_REG_MCUCTR, AW22127_MCUCTR_MAILBOX);
+	ret = ret ?: regmap_write(rm, AW22127_REG_TASK0, 0x80);
+
+	return ret;
+}
+
+static void aw22127_off(struct aw22127 *aw)
+{
+	struct regmap *rm = aw->regmap;
+
+	if (!aw->on)
+		return;
+
+	regmap_write(rm, AW22127_REG_PAGE, 0);
+	regmap_write(rm, AW22127_REG_TASK0, 0);
+	regmap_write(rm, AW22127_REG_MCUCTR, 0x01);
+	regmap_write(rm, AW22127_REG_GCR, 0);
+	regmap_write(rm, AW22127_REG_SRST, AW22127_SRST_RESET);
+	aw22127_power(aw, false);
+	aw->on = false;
+}
+
+static int aw22127_run(struct aw22127 *aw, const struct aw22127_step *steps,
+		       unsigned int nsteps)
+{
+	u8 cmd[AW22127_CMD_MAX];
+	u8 *p = cmd + sizeof(aw22127_cmd_hdr);
+	size_t len = sizeof(aw22127_cmd_hdr) + nsteps * AW22127_STEP_LEN;
+	unsigned int i;
+	int ret;
+
+	memcpy(cmd, aw22127_cmd_hdr, sizeof(aw22127_cmd_hdr));
+	cmd[AW22127_CMD_NSTEPS] = nsteps;
+	for (i = 0; i < nsteps; i++, p += AW22127_STEP_LEN) {
+		put_unaligned_be16(steps[i].ms, p);
+		p[2] = steps[i].from;
+		p[3] = steps[i].to;
+		p[4] = aw->subled[0].intensity;
+		p[5] = aw->subled[1].intensity;
+		p[6] = aw->subled[2].intensity;
+	}
+
+	if (aw->on && len == aw->cmd_len && !memcmp(cmd, aw->cmd, len))
+		return 0;
+
+	if (!aw->on)
+		aw22127_power(aw, true);
+	ret = aw22127_play(aw, cmd, len);
+	if (ret) {
+		aw22127_power(aw, false);
+		aw->on = false;
+		aw->cmd_len = 0;
+		return ret;
+	}
+	aw->on = true;
+	memcpy(aw->cmd, cmd, len);
+	aw->cmd_len = len;
+
+	return 0;
+}
+
+static struct aw22127 *cdev_to_aw22127(struct led_classdev *cdev)
+{
+	return container_of(lcdev_to_mccdev(cdev), struct aw22127, mc);
+}
+
+static int aw22127_brightness_set(struct led_classdev *cdev,
+				  enum led_brightness brightness)
+{
+	struct aw22127 *aw = cdev_to_aw22127(cdev);
+	struct aw22127_step step = {
+		.ms = AW22127_STATIC_MS,
+		.from = brightness,
+		.to = brightness,
+	};
+	int ret = 0;
+
+	mutex_lock(&aw->lock);
+	if (brightness)
+		ret = aw22127_run(aw, &step, 1);
+	else
+		aw22127_off(aw);
+	mutex_unlock(&aw->lock);
+
+	return ret;
+}
+
+static int aw22127_pattern_set(struct led_classdev *cdev,
+			       struct led_pattern *pattern, u32 len, int repeat)
+{
+	struct aw22127 *aw = cdev_to_aw22127(cdev);
+	struct aw22127_step steps[AW22127_MAX_STEPS];
+	unsigned int i;
+	int ret;
+
+	if (repeat != -1 || !len || len > AW22127_MAX_STEPS)
+		return -EINVAL;
+
+	for (i = 0; i < len; i++) {
+		if (!pattern[i].delta_t || pattern[i].delta_t > U16_MAX)
+			return -EINVAL;
+		steps[i].ms = pattern[i].delta_t;
+		steps[i].from = pattern[i].brightness;
+		steps[i].to = pattern[(i + 1) % len].brightness;
+	}
+
+	mutex_lock(&aw->lock);
+	ret = aw22127_run(aw, steps, len);
+	mutex_unlock(&aw->lock);
+
+	return ret;
+}
+
+static int aw22127_pattern_clear(struct led_classdev *cdev)
+{
+	struct aw22127 *aw = cdev_to_aw22127(cdev);
+
+	mutex_lock(&aw->lock);
+	aw22127_off(aw);
+	mutex_unlock(&aw->lock);
+
+	return 0;
+}
+
+static int aw22127_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct led_init_data init = {};
+	struct aw22127 *aw;
+	unsigned int id;
+	int ret;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->dev = dev;
+	mutex_init(&aw->lock);
+
+	aw->regmap = devm_regmap_init_i2c(client, &aw22127_regmap);
+	if (IS_ERR(aw->regmap))
+		return PTR_ERR(aw->regmap);
+
+	aw->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset))
+		return dev_err_probe(dev, PTR_ERR(aw->reset), "reset gpio\n");
+
+	aw22127_power(aw, true);
+	ret = regmap_read(aw->regmap, AW22127_REG_CHIPID, &id);
+	aw22127_power(aw, false);
+	if (ret)
+		return dev_err_probe(dev, ret, "reading chip ID\n");
+	if (id != AW22127_CHIPID)
+		return dev_err_probe(dev, -ENODEV, "chip ID 0x%02x, not an AW22127\n", id);
+
+	aw->subled[0].color_index = LED_COLOR_ID_RED;
+	aw->subled[1].color_index = LED_COLOR_ID_GREEN;
+	aw->subled[2].color_index = LED_COLOR_ID_BLUE;
+	aw->subled[0].intensity = 255;
+	aw->subled[1].intensity = 255;
+	aw->subled[2].intensity = 255;
+
+	aw->mc.subled_info = aw->subled;
+	aw->mc.num_colors = ARRAY_SIZE(aw->subled);
+	aw->mc.led_cdev.max_brightness = 255;
+	aw->mc.led_cdev.brightness_set_blocking = aw22127_brightness_set;
+	aw->mc.led_cdev.pattern_set = aw22127_pattern_set;
+	aw->mc.led_cdev.pattern_clear = aw22127_pattern_clear;
+
+	init.fwnode = dev_fwnode(dev);
+	init.devicename = "aw22127";
+	init.default_label = "rgb:indicator";
+
+	ret = devm_led_classdev_multicolor_register_ext(dev, &aw->mc, &init);
+	if (ret)
+		return dev_err_probe(dev, ret, "registering LED\n");
+
+	i2c_set_clientdata(client, &aw->mc);
+
+	return 0;
+}
+
+static void aw22127_remove(struct i2c_client *client)
+{
+	struct led_classdev_mc *mc = i2c_get_clientdata(client);
+
+	if (mc) {
+		struct aw22127 *aw = container_of(mc, struct aw22127, mc);
+
+		mutex_lock(&aw->lock);
+		aw22127_off(aw);
+		mutex_unlock(&aw->lock);
+	}
+}
+
+static const struct of_device_id aw22127_of_match[] = {
+	{ .compatible = "awinic,aw22127" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw22127_of_match);
+
+static struct i2c_driver aw22127_driver = {
+	.driver = {
+		.name = "leds-aw22127",
+		.of_match_table = aw22127_of_match,
+	},
+	.probe = aw22127_probe,
+	.remove = aw22127_remove,
+};
+module_i2c_driver(aw22127_driver);
+
+MODULE_AUTHOR("joonhoekim <26rote@gmail.com>");
+MODULE_DESCRIPTION("Awinic AW22127 RGB LED driver");
+MODULE_LICENSE("GPL");
-- 
