+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __SD_RETIMER_O2_H
+#define __SD_RETIMER_O2_H
+
+struct mmc_card;
+struct mmc_host;
+struct o2_retimer;
+struct sdhci_host;
+
+#if IS_ENABLED(CONFIG_MMC_SD_RETIMER_O2)
+struct o2_retimer *o2_retimer_probe(struct sdhci_host *host);
+void o2_retimer_init_card(struct o2_retimer *o2, struct mmc_host *mmc,
+			  struct mmc_card *card);
+int o2_retimer_execute_tuning(struct o2_retimer *o2, struct mmc_host *mmc,
+			      u32 opcode,
+			      int (*tune)(struct mmc_host *mmc, u32 opcode));
+#else
+static inline struct o2_retimer *o2_retimer_probe(struct sdhci_host *host)
+{
+	return NULL;
+}
+
+static inline void o2_retimer_init_card(struct o2_retimer *o2,
+					struct mmc_host *mmc,
+					struct mmc_card *card) { }
+
+static inline int o2_retimer_execute_tuning(struct o2_retimer *o2,
+					    struct mmc_host *mmc, u32 opcode,
+					    int (*tune)(struct mmc_host *mmc,
+							u32 opcode))
+{
+	return tune(mmc, opcode);
+}
