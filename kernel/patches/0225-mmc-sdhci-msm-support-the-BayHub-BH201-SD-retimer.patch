 drivers/mmc/host/sd-retimer-o2.c | 704 +++++++++++++++++++++++++++++++
 drivers/mmc/host/sd-retimer-o2.h |  36 ++
 drivers/mmc/host/sdhci-msm.c     |  26 ++
 5 files changed, 781 insertions(+)
 create mode 100644 drivers/mmc/host/sd-retimer-o2.c
 create mode 100644 drivers/mmc/host/sd-retimer-o2.h

