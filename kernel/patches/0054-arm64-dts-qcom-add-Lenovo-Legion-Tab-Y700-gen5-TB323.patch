diff --git a/arch/arm64/boot/dts/qcom/baldur-touch.dtsi b/arch/arm64/boot/dts/qcom/baldur-touch.dtsi
new file mode 100644
index 000000000..cd8b0074a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/baldur-touch.dtsi
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * TB323FU ("baldur"): touch, the NT36523 TDDI's touch half on SPI19.
+ *
+ * Vendor node: spi@1a80000 novatek@0, "novatek,NVT-ts-spi", 19.2 MHz,
+ * INT tlmm gpio158, reset tlmm gpio66 (the driver pulses it), pen.
+ * The chip is an NT36536; the driver is Novatek's own NT36536
+ * host-download driver as carried in map220v/sm8850-mainline (branch
+ * iceland-7.2, drivers/input/touchscreen/nt36536). It finds the register
+ * set itself, follows the panel (drm_panel_follower) and loads the firmware
+ * named here. It handles neither the reset line nor the supply: reset keeps
+ * the vendor's pull-up, and the touch VDD is simply left on.
+ */
+
+/* vendor: display node tvdd-supply; nothing here asks for it */
+&vreg_l4b_1p8 {
+	regulator-always-on;
+};
+
+&spi19 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+		spi-max-frequency = <19200000>;
+
+		pinctrl-0 = <&ts_int_default>, <&ts_reset_default>;
+		pinctrl-names = "default";
+
+		irq-gpios = <&tlmm 158 GPIO_ACTIVE_HIGH>;
+		novatek,pen-support;
+		firmware-name = "novatek/novatek_ts_fw.bin";
+		panel = <&panel0>;
+	};
+};
+
+&tlmm {
+	ts_int_default: ts-int-default-state {
+		pins = "gpio158";
+		function = "gpio";
+		input-enable;
+		bias-disable;
+	};
+
+	/* vendor tp_reset_gpio */
+	ts_reset_default: ts-reset-default-state {
+		pins = "gpio66";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/baldur-usb.dtsi b/arch/arm64/boot/dts/qcom/baldur-usb.dtsi
new file mode 100644
index 000000000..da47da8d1
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/baldur-usb.dtsi
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * TB323FU ("baldur"): USB-C as a high-speed USB device.
+ *
+ * The point is a way in: a CDC-ACM serial console (and NCM networking) from
+ * the PC, instead of photographs of the panel. So this is the smallest USB that
+ * enumerates -- peripheral only, high speed only:
+ *
+ *  - no SuperSpeed PHY (usb_dp_qmpphy) and no Type-C orientation, which on
+ *    this SoC go through pmic-glink over the SOCCP remoteproc, not up here
+ *  - no role switching; the port is a device, as it is for adb
+ *
+ * Same shape as the OnePlus 15 (kaanapali-oneplus-infiniti-common.dts), which
+ * is the same SoC with the same eUSB2 repeater on pmih0108 at SPMI1 SID 7.
+ * Android here uses a600000.dwc3 and the repeater at
+ * c437000.spmi:qcom,pmih010x@7:eusb2-repeater@fd00 -- the same pair.
+ * Rails from this device's vendor tree: repeater vdd18 pmh0101 l15 (1.8 V),
+ * vdd3 pmh0101 l5 (3.100-3.148 V); PHY vdd pmh0110 F l4 (0.880-0.912 V),
+ * vdda12 pmh0110 D l1 (1.2 V).
+ */
+
+&pmih0108_e1_eusb2_repeater {
+	vdd18-supply = <&vreg_l15b_1p8>;
+	vdd3-supply = <&vreg_l5b_3p1>;
+
+	status = "okay";
+};
+
+&usb_hsphy {
+	vdd-supply = <&vreg_l4f_0p8>;
+	vdda12-supply = <&vreg_l1d_1p2>;
+
+	phys = <&pmih0108_e1_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb {
+	/*
+	 * Data role from ucsi (pmic-glink connector@0); peripheral until
+	 * it says otherwise, so the PC link comes up as before.
+	 */
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+
+	/delete-property/ snps,usb3_lpm_capable;
+
+	status = "okay";
+};
+
+/*
+ * SuperSpeed: the QMP USB3-DP combo PHY as on the MTP (vendor ssphy:
+ * vdd pmh0110 F l4, core pmh0110 D l1); its orientation comes from the
+ * pmic-glink connector (ucsi), its SS lanes go to the dwc3 (kaanapali.dtsi).
+ */
+&usb_dp_qmpphy {
+	vdda-phy-supply = <&vreg_l1d_1p2>;
+	vdda-pll-supply = <&vreg_l4f_0p8>;
+
+	status = "okay";
+};
+
+&usb_dp_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
+};
diff --git a/arch/arm64/boot/dts/qcom/baldur-wifi.dtsi b/arch/arm64/boot/dts/qcom/baldur-wifi.dtsi
new file mode 100644
index 000000000..4dced6128
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/baldur-wifi.dtsi
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * TB323FU ("baldur"): Wi-Fi, WCN7860 "peach" (17cb:110e) on PCIe0, ath12k.
+ *
+ * The same chip and pins as the OnePlus 15 port (infiniti-mainline, which
+ * follows kaanapali-mtp.dts): wlan-en gpio16, sw-ctrl gpio18, PERST gpio102,
+ * CLKREQ gpio103, WAKE gpio104. The rails are this device's own, decoded from
+ * its vendor cnss-peach node (qcom,pmu_vreg_map and vdd-wlan-*-supply): AON
+ * 0.9 V comes from S2J here, not from S7G as on the MTP.
+ *
+ * NOT WORKING YET, and not included by any board file: the chip never answers
+ * link training (LTSSM loops in Detect, "Device not found").
+ *
+ * Bluetooth itself (UART) is left out, but its enable line is described: the
+ * vendor cnss drives BT_EN low before it powers WLAN ("cnss_probe: Disabling
+ * BT_EN"), and the sequencer does the same when it owns the pin. A PMIC GPIO
+ * keeps its level across a warm reboot, so after Android ran with Bluetooth
+ * on it would otherwise still be high here. Needs pmh0104-kaanapali.dtsi.
+ */
+
+&pmh0104_j_e1_gpios {
+	bt_default: bt-default-state {
+		pins = "gpio5";
+		function = "normal";
+		input-disable;
+		output-enable;
+		bias-disable;
+		power-source = <1>;
+	};
+};
+
+&tlmm {
+	wlan_en: wlan-en-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	/* vendor cnss_wlan_sw_ctrl / cnss_wlan_sw_ctrl_wl_cx */
+	sw_ctrl_default: sw-ctrl-default-state {
+		sw-ctrl-pins {
+			pins = "gpio18";
+			function = "wcn_sw_ctrl";
+			bias-pull-down;
+		};
+
+		sw-ctrl-wl-cx-pins {
+			pins = "gpio19";
+			function = "wcn_sw";
+			bias-pull-down;
+		};
+	};
+
+	/*
+	 * Sign-of-life lines (vendor cnss_host_sol_default, wlan-host-sol-gpio
+	 * 204, wlan-dev-sol-gpio 205). Both are eGPIOs that another subsystem
+	 * owns until something selects function "gpio"; the vendor cnss does,
+	 * and drives host-SOL low, before it powers the chip. Left alone, the
+	 * chip held WAKE# low and never answered link training.
+	 */
+	wlan_sol_default: wlan-sol-default-state {
+		host-sol-pins {
+			pins = "gpio204";
+			function = "gpio";
+			drive-strength = <4>;
+			bias-pull-down;
+			output-low;
+		};
+
+		dev-sol-pins {
+			pins = "gpio205";
+			function = "gpio";
+			bias-pull-down;
+			input-enable;
+		};
+	};
+
+	pcie0_default_state: pcie0-default-state {
+		perst-n-pins {
+			pins = "gpio102";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		clkreq-n-pins {
+			pins = "gpio103";
+			function = "pcie0_clk_req_n";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		wake-n-pins {
+			pins = "gpio104";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
+
+/ {
+	wcn7860-pmu {
+		/* no WCN7860 binding; the WCN7850 sequencer is what the OnePlus port uses */
+		compatible = "qcom,wcn7850-pmu";
+
+		pinctrl-0 = <&bt_default>, <&sw_ctrl_default>, <&wlan_sol_default>, <&wlan_en>;
+		pinctrl-names = "default";
+
+		bt-enable-gpios = <&pmh0104_j_e1_gpios 5 GPIO_ACTIVE_HIGH>;
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_s2j_0p8>;
+		vddio-supply = <&vreg_l2g_1p8>;
+		vddio1p2-supply = <&vreg_l3g_1p2>;
+		vddaon-supply = <&vreg_s2j_0p8>;
+		vdddig-supply = <&vreg_s1j_0p8>;
+		vddrfa1p2-supply = <&vreg_s7f_1p2>;
+		vddrfa1p8-supply = <&vreg_s8f_1p8>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+};
+
+&vreg_l3k_1p2 {
+	regulator-always-on;
+};
+
+/*
+ * Experiment: WLCX/WLMX at the vendor cnss votes. The PMIC ranges start
+ * at 0.4/0.5 V and the regulator core parks an unset rail at its minimum;
+ * on Android the PDC raises them on the chip's clock requests, here nothing
+ * may. BT (UART) answers either way -- it does not use WLCX/WLMX.
+ */
+&vreg_s1j_0p8 {
+	regulator-min-microvolt = <892000>;
+};
+
+&vreg_s2j_0p8 {
+	regulator-min-microvolt = <892000>;
+};
+
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l3i_0p8>;
+	vdda-pll-supply = <&vreg_l1d_1p2>;
+
+	status = "okay";
+};
+
+&pcie_port0 {
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+
+	wifi@0 {
+		compatible = "pci17cb,110e";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
+};
+
+/*
+ * Bluetooth, the same chip over the 4-wire HS-UART (vendor
+ * qupv3_se18_4uart @ 0x1994000 = uart18), as the OnePlus 15 port wires it.
+ * First used to ask whether the WCN7860 is alive at all -- the HCI
+ * version read comes before any firmware.
+ */
+/ {
+	aliases {
+		/* the geni UART driver wants a line number ("Invalid line -19") */
+		serial1 = &uart18;
+	};
+};
+
+&uart18 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn7850-bt";
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+
+		/* the rate the OnePlus 15 port runs this chip at (peri baud command) */
+		max-speed = <3200000>;
+
+		/*
+		 * This chip's own firmware from its bluetooth partition
+		 * (/vendor/bt_firmware/image, BTFW.BRAHMA.2.0.1-00238): NVM, then
+		 * the rampatch. The TLV there times out on its first segment with
+		 * the stock WCN7850 flow; the ELF goes through the BRAHMA path of
+		 * infiniti fecd7925d (0030).
+		 */
+		firmware-name = "brhbtnv20.bin", "brhbtfw20.mbn";
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts b/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts
