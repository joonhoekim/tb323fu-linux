From 45efd4bda38ee757cd30eedf9fbc06d716b707d7 Mon Sep 17 00:00:00 2001
From: li-yiyang <yiyang.li.11pro@outlook.com>
Date: Mon, 23 Nov 2026 21:18:40 +0800
Subject: [PATCH 4/4] mmc: sdhci-msm: clamp a stale BH201 resume phase to 100
 MHz

On a system resume the core powers the card up and re-initialises it in
place.  A 121-cell retimer sweep there would have to re-enumerate the card
with mmc_detect_change(), which removes the block device under the mounted
root; the MMC core has no block-device-safe re-initialisation.  The driver
therefore only re-scores the stored phase.

If that score failed it used to clear MMC_CAP_UHS_SDR104 and return the
host tuning result, which is 0 when the host tuning succeeded: the current
attach reported success and kept running at the phase that had just failed.
A failed host tuning had the same problem.

Clamp the current attach to 100 MHz (the validated SDR104 timing and 100m
table) on either failure instead, and keep the cap cleared so the next
re-init selects SDR50.  The next boot calibrates 202 MHz again.  Also
restore MMC_CAP_UHS_SDR104 when a different card is inserted after a failed
calibration.

Tested with an injected stale phase and with a forced host tuning failure:
both end at 100 MHz, timing 6, 1 GiB at 44-46 MB/s, reads clean, filesystem
clean.  Ten unforced s2idle cycles keep 202 MHz at 87-88 MB/s, also clean.

Signed-off-by: li-yiyang <yiyang.li.11pro@outlook.com>
---
 drivers/mmc/host/Kconfig         |  9 +++--
 drivers/mmc/host/sd-retimer-o2.c | 61 ++++++++++++++++++++++++++------
 2 files changed, 56 insertions(+), 14 deletions(-)

diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index 80da0e4f7..fba0b414b 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -632,9 +632,12 @@ config MMC_SD_RETIMER_O2
 	  at card init time and calibrates the retimer's 200 MHz TX phase
 	  by re-enumerating the card once per candidate phase and reading
 	  a known block over the real 202 MHz link.  The retimer's phase
-	  map moves with every DLL re-lock, so the sweep runs at boot and
-	  again when a stored phase stops reading;
-	  SDR50 is used if no phase passes.
+	  map moves with every DLL re-lock, so the sweep runs at every boot.
+	  A re-init of a registered card (a system resume) cannot sweep: it
+	  would have to re-enumerate the card and remove the block device
+	  under the mounted root.  It re-scores the stored phase and, on a
+	  miss, drops the current attach to 100 MHz; the next re-init selects
+	  SDR50 and the next boot calibrates again.
 
 	  If unsure, say N.
 
diff --git a/drivers/mmc/host/sd-retimer-o2.c b/drivers/mmc/host/sd-retimer-o2.c
index 1facee458..feb5009dc 100644
--- a/drivers/mmc/host/sd-retimer-o2.c
+++ b/drivers/mmc/host/sd-retimer-o2.c
@@ -33,9 +33,11 @@
  * card off and re-initialises it) re-scores the stored phase with three LBA0
  * reads.  That check cannot repair anything - a new phase needs a sweep, a
  * sweep needs the card to be re-enumerated, and at that point the card is
- * registered and may hold the mounted root filesystem - so it reports the
- * miss and drops SDR104 for the next re-init (SDR50); the next boot
- * calibrates again before the root is mounted.
+ * registered and may hold the mounted root filesystem, and the MMC core has
+ * no block-device-safe re-enumeration.  On a miss the current attach is
+ * clamped to 100 MHz (the validated SDR104 timing and 100m table), SDR104 is
+ * dropped for the next re-init (SDR50), and the next boot calibrates again
+ * before the root is mounted.
  * If the whole sweep fails, SDR104 is dropped and the card is re-enumerated at
  * SDR50: the unit still boots (the vendor's own degrade path) and the map
  * stays in the log.
@@ -141,6 +143,7 @@ struct o2_retimer {
 	bool calib_done;
 	bool calib_failed;
 	bool stale;		/* the stored phase stopped reading at runtime */
+	u32 sdr104_cap;		/* MMC_CAP_UHS_SDR104 before the calibration */
 };
 
 static LIST_HEAD(o2_retimers);
@@ -653,11 +656,29 @@ static int o2_data_calib(struct o2_retimer *o2, struct mmc_host *mmc, int host_r
 	return o2_calib_step(o2, mmc, score);
 }
 
+/*
+ * mmc_set_clock() is private to the MMC core, so do the same two steps from
+ * the host driver: update the core's ios and ask the host to apply it.  Only
+ * used on the non-boot degrade path, where the retimer's 100m table is already
+ * in place and 100 MHz is the validated SDR50 configuration.
+ */
+static void o2_clamp_clock(struct mmc_host *mmc, struct o2_retimer *o2)
+{
+	struct mmc_ios ios = mmc->ios;
+
+	if (ios.clock <= 100000000)
+		return;
+	ios.clock = 100000000;
+	mmc->ios.clock = ios.clock;
+	if (o2->orig_ops && o2->orig_ops->set_ios)
+		o2->orig_ops->set_ios(mmc, &ios);
+}
+
 static int o2_execute_tuning(struct mmc_host *mmc, u32 opcode)
 {
 	struct o2_retimer *o2 = o2_find(mmc);
 	bool boot = !mmc->card;
-	int host_rc;
+	int host_rc, score = 0;
 
 	if (!o2)
 		return 0;
@@ -684,13 +705,19 @@ static int o2_execute_tuning(struct mmc_host *mmc, u32 opcode)
 	 * an attach after the card was removed): a failed attach leaves no
 	 * block device behind.  A system resume re-initialises the registered
 	 * card in place, and there a sweep would delete the block device under
-	 * the mounted root filesystem.  So a resume only checks the stored
-	 * phase; on a miss SDR104 is dropped so the next re-init comes up at
-	 * SDR50, and the next boot calibrates again.
+	 * the mounted root filesystem; the MMC core has no block-device-safe
+	 * re-enumeration.  So a resume only checks the stored phase; on a miss
+	 * the current attach is clamped to 100 MHz (the validated SDR104
+	 * timing and 100m table), SDR104 is dropped so the next re-init comes
+	 * up at SDR50, and the next boot calibrates 202 MHz again.
 	 */
 	if (!boot) {
-		if (o2->calib_done && !host_rc &&
-		    o2_score_lba0(o2, mmc, 0) >= 2) {
+		if (o2->calib_done && !host_rc)
+			score = o2_score_lba0(o2, mmc, 0);
+		if (score >= 2) {
+			dev_info(mmc->parent,
+				 "BH201 calib: resume verify phase %d/%d score %d/3\n",
+				 o2->sela, o2->selb, score);
 			if (o2->stale) {
 				dev_info(mmc->parent,
 					 "BH201 calib: phase %d/%d reads again\n",
@@ -702,11 +729,21 @@ static int o2_execute_tuning(struct mmc_host *mmc, u32 opcode)
 
 		if (!o2->stale)
 			dev_err(mmc->parent,
-				"BH201 calib: phase %d/%d no longer reads after the card was re-initialised (host %d); SDR50 from the next re-init, 202 MHz returns at the next boot\n",
+				"BH201 calib: phase %d/%d no longer reads after the card was re-initialised (host %d); clock clamped to 100 MHz for this attach, SDR50 from the next re-init\n",
 				o2->sela, o2->selb, host_rc);
 		o2->stale = true;
 		mmc->caps &= ~MMC_CAP_UHS_SDR104;
-		return host_rc;
+		/*
+		 * Clearing the capability only changes the next init.  A
+		 * re-enumeration here would remove the block device under the
+		 * mounted root, so put this attach on the already validated
+		 * 100 MHz configuration (SDR104 timing at 100 MHz, the
+		 * retimer's 100m table) instead of leaving the root at a phase
+		 * that just failed.  This also covers a failed host tuning:
+		 * the 202 MHz path is unusable, and 100 MHz does not need it.
+		 */
+		o2_clamp_clock(mmc, o2);
+		return 0;
 	}
 
 	if (!o2->present || !o2->golden_valid)
@@ -751,6 +788,7 @@ static void o2_hw_init(struct o2_retimer *o2, struct mmc_card *card)
 		o2->ncand = 0;
 		o2->centre_tries = 0;
 		memset(o2->pass_row, 0, sizeof(o2->pass_row));
+		mmc->caps |= o2->sdr104_cap;
 	}
 	memcpy(o2->cid, card->raw_cid, sizeof(o2->cid));
 	o2->cid_valid = true;
@@ -849,6 +887,7 @@ void o2_retimer_install(struct sdhci_host *host)
 	INIT_LIST_HEAD(&o2->list);
 
 	o2->orig_ops = mmc->ops;
+	o2->sdr104_cap = mmc->caps & MMC_CAP_UHS_SDR104;
 	o2->ops = *mmc->ops;
 	o2->ops.init_card = o2_init_card;
 	o2->ops.execute_tuning = o2_execute_tuning;
-- 
