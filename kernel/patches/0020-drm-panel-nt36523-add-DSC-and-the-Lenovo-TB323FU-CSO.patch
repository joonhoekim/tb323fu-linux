From df6c27a45abaecff479148c2844619d7d9658a74 Mon Sep 17 00:00:00 2001
From: joonhoekim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 01:25:39 +0000
Subject: [PATCH 20/56] drm/panel: nt36523: add DSC, and the Lenovo TB323FU
 CSOT panel

The driver already drives dual-DSI nt36523 panels, but only uncompressed ones,
because the two tablets it covers do not compress the link. The Lenovo Legion
Tab Y700 5th Gen ("baldur") has the same controller driving 1904x3040 as two
952-wide links, in video mode, over DSC 1.2.

DSC is optional per panel: a descriptor that sets dsc_cfg gets its PPS packed
and sent, and compression enabled, on each link after its init sequence runs.
The host is told before attach, since it sizes the DSI timings off that.

The init sequence is the one this device's bootloader passes to Android,
decoded out of qcom,mdss-dsi-on-command: 26 packets, page selects and the
0x90/0x91/0x92 compression registers and one timing block, then sleep out and
display on with the vendor's own waits. It is much shorter than the elish
sequences because this panel keeps most of its setup in ROM.

There is no dual variant of exit_sleep_mode/set_display_on, so the generic
mipi_dsi_dual() wrapper runs each on both links.

NOT TESTED ON HARDWARE. The device has not been booted with a mainline kernel
yet; this builds and is written from the vendor devicetree, no more.

Update, 2026-09-24: the panel is 10 bpc -- the vendor node for the
active panel (qcom,mdss_dsi_baldur_nt36523_csot_3k_dsc_vid) says
qcom,mdss-dsi-bpp = 30 and DSC bits-per-component 10 -- so the link format
is RGB101010, and it has no tx-eot-append, so NO_EOT_PACKET. The DSC config
is copied per device: the DSI host writes pic_width and the RC fields into
it, which on the static const descriptor only worked before rodata went
read-only. The PPS is packed from that copy.
---
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 163 ++++++++++++++++++
 1 file changed, 163 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index 34b9123d3..834cfbdce 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -15,6 +15,8 @@
 
 #include <video/mipi_display.h>
 
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
 #include <drm/drm_connector.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_mipi_dsi.h>
@@ -33,6 +35,8 @@ struct panel_info {
 	struct gpio_desc *reset_gpio;
 	struct backlight_device *backlight;
 	struct regulator *vddio;
+	/* per-device copy: the DSI host fills pic_width and the RC fields */
+	struct drm_dsc_config *dsc;
 };
 
 struct panel_desc {
@@ -47,6 +51,8 @@ struct panel_desc {
 	const struct drm_display_mode *modes;
 	unsigned int num_modes;
 	const struct mipi_dsi_device_info dsi_info;
+	/* Panels that run the link compressed point this at their config. */
+	const struct drm_dsc_config *dsc_cfg;
 	int (*init_sequence)(struct panel_info *pinfo);
 
 	bool is_dual_dsi;
@@ -1013,6 +1019,26 @@ static int nt36523_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
+	if (pinfo->desc->dsc_cfg) {
+		struct drm_dsc_picture_parameter_set pps;
+		int i;
+
+		drm_dsc_pps_payload_pack(&pps, pinfo->dsc);
+
+		for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+			struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i] };
+
+			mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+			mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+			if (dsi_ctx.accum_err) {
+				regulator_disable(pinfo->vddio);
+				dev_err(panel->dev, "failed to set up DSC on DSI%d: %d\n",
+					i, dsi_ctx.accum_err);
+				return dsi_ctx.accum_err;
+			}
+		}
+	}
+
 	return 0;
 }
 
@@ -1228,10 +1254,22 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 
 	drm_panel_add(&pinfo->panel);
 
+	if (pinfo->desc->dsc_cfg) {
+		pinfo->dsc = devm_kmemdup(dev, pinfo->desc->dsc_cfg,
+					  sizeof(*pinfo->dsc), GFP_KERNEL);
+		if (!pinfo->dsc)
+			return -ENOMEM;
+	}
+
 	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
 		pinfo->dsi[i]->lanes = pinfo->desc->lanes;
 		pinfo->dsi[i]->format = pinfo->desc->format;
 		pinfo->dsi[i]->mode_flags = pinfo->desc->mode_flags;
+		/*
+		 * The host sizes its DSI timings off this, so it has to be set
+		 * before attach rather than at prepare time.
+		 */
+		pinfo->dsi[i]->dsc = pinfo->dsc;
 
 		ret = devm_mipi_dsi_attach(dev, pinfo->dsi[i]);
 		if (ret < 0)
@@ -1241,7 +1279,132 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 	return 0;
 }
 
+
+/*
+ * Lenovo Legion Tab Y700 5th Gen (TB323FU, "baldur"): CSOT NT36523, 1904x3040,
+ * dual-DSI (952 per link), video mode, DSC 1.2.
+ *
+ * The sequence below is the one this device's own bootloader passes to
+ * Android, decoded out of qcom,mdss-dsi-on-command in /sys/firmware/fdt (26
+ * packets, 258 bytes). It is far shorter than the elish sequences above
+ * because most of this panel's setup lives in its own ROM; what is here is
+ * page selects, the compression registers (0x90/0x91/0x92), one timing block,
+ * then sleep out and display on. Every write goes to both links, as the vendor
+ * sends them.
+ */
+static int baldur_csot_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x23);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x89, 0xa4);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xe0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xbb, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xe6, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x27);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd0, 0x33);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd1, 0x05);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xde, 0x43);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xdf, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x3b, 0x03, 0x4e,
+					  0x1a, 0x04, 0x04, 0x01, 0x80, 0x36,
+					  0x36);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x60, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x90, 0x03, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x91, 0xab, 0xa8,
+					  0x00, 0x14, 0xd2, 0x00, 0x00, 0x00,
+					  0x01, 0xb9, 0x00, 0x06, 0x05, 0x7a,
+					  0x05, 0xb8);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x92, 0x10, 0xe0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb2, 0x91, 0x80);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb3, 0x40);
+
+	/*
+	 * There is no dual variant of these two, so the generic mipi_dsi_dual()
+	 * wrapper is used to run each on both links. The waits are the vendor's
+	 * (its packets carry wait=105 and wait=40).
+	 */
+	mipi_dsi_dual(mipi_dsi_dcs_exit_sleep_mode_multi, &dsi_ctx, dsi0, dsi1);
+	mipi_dsi_msleep(&dsi_ctx, 105);
+	mipi_dsi_dual(mipi_dsi_dcs_set_display_on_multi, &dsi_ctx, dsi0, dsi1);
+	mipi_dsi_msleep(&dsi_ctx, 40);
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * DSC as the vendor timing block states it: 1.2, slice 476x20, two slices per
+ * link, 10 bits per component, compressed to 8 bits per pixel.
+ * 476 * 2 = 952, which is one link's width.
+ */
+static const struct drm_dsc_config baldur_csot_dsc_cfg = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 2,
+	.slice_height = 20,
+	.slice_width = 476,
+	.slice_count = 2,
+	.bits_per_component = 10,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+/*
+ * Horizontal values are per link in the vendor devicetree and are doubled
+ * here, the way the himax dual-DSI panels write theirs; vertical values are
+ * not. Only the 120 Hz mode is described: the panel advertises 165/144/90/60/30
+ * as well, but the vendor carries one set of porches and switches refresh rate
+ * through its own dynamic-timing nodes.
+ */
+static const struct drm_display_mode baldur_csot_modes[] = {
+	{
+		.clock = (952 + 90 + 16 + 64) * 2 * (3040 + 26 + 4 + 330) * 120 / 1000,
+		.hdisplay = 952 * 2,
+		.hsync_start = (952 + 90) * 2,
+		.hsync_end = (952 + 90 + 16) * 2,
+		.htotal = (952 + 90 + 16 + 64) * 2,
+		.vdisplay = 3040,
+		.vsync_start = 3040 + 26,
+		.vsync_end = 3040 + 26 + 4,
+		.vtotal = 3040 + 26 + 4 + 330,
+	},
+};
+
+static const struct panel_desc baldur_csot_desc = {
+	.modes = baldur_csot_modes,
+	.num_modes = ARRAY_SIZE(baldur_csot_modes),
+	.dsi_info = {
+		.type = "BALDUR-CSOT",
+		.channel = 0,
+		.node = NULL,
+	},
+	.width_mm = 168,
+	.height_mm = 268,
+	.bpc = 10,
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB101010,	/* vendor qcom,mdss-dsi-bpp = 30 */
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM |
+		      MIPI_DSI_MODE_NO_EOT_PACKET |	/* vendor: no tx-eot-append */
+		      MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT, /* vendor slice-per-pkt = 2 */
+	.dsc_cfg = &baldur_csot_dsc_cfg,
+	.init_sequence = baldur_csot_init_sequence,
+	.is_dual_dsi = true,
+};
+
 static const struct of_device_id nt36523_of_match[] = {
+	{
+		.compatible = "lenovo,baldur-csot-nt36523",
+		.data = &baldur_csot_desc,
+	},
 	{
 		.compatible = "lenovo,j606f-boe-nt36523w",
 		.data = &j606f_boe_desc,
-- 
2.43.0

