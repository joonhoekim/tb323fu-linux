From 34162f9f812c29a9d37136d6583999bbad07eb34 Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Mon, 2 Nov 2026 23:11:46 +0000
Subject: [PATCH] arm64: configs: baldur: drop no_console_suspend from
 the command line

no_console_suspend makes the PM core switch to the suspend console on
every suspend, although the DRM fbdev emulation marks itself as not
needing that switch. On the switch fbcon restores the fbdev
configuration it saved earlier, which can still include a DisplayPort
monitor that was unplugged since. The DP controller then trains a link
to nothing right before suspend, and its AUX channel does not work
after resume, so a monitor plugged in during suspend is not detected.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 arch/arm64/configs/baldur.fragment | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/configs/baldur.fragment b/arch/arm64/configs/baldur.fragment
index 08ffa1de52..f52303aac3 100644
--- a/arch/arm64/configs/baldur.fragment
+++ b/arch/arm64/configs/baldur.fragment
@@ -33,7 +33,7 @@ CONFIG_ARM64_BUILTIN_FDT_NAME="qcom/kaanapali-lenovo-baldur.dtb"
 # qcom_scm.download_mode=full: once SCM has probed, an unclean restart (panic)
 # enters the XBL crash dump mode, whose collector writes the ramoops console to
 # the UFS rawdump partition. That copy survives a later power-off and EDL.
-CONFIG_CMDLINE="icc-rpmh.qos_disable=1 icc_rpmh.qos_disable=1 fw_devlink.sync_state=timeout fbcon=font:TER16x32 panic=10 oops=panic console=tty1 keep_bootcon qcom_scm.download_mode=full baldur.end=hold consoleblank=120 no_console_suspend mem_sleep_default=s2idle cpuidle_psci_domain.allow_cluster_off=0"
+CONFIG_CMDLINE="icc-rpmh.qos_disable=1 icc_rpmh.qos_disable=1 fw_devlink.sync_state=timeout fbcon=font:TER16x32 panic=10 oops=panic console=tty1 keep_bootcon qcom_scm.download_mode=full baldur.end=hold consoleblank=120 mem_sleep_default=s2idle cpuidle_psci_domain.allow_cluster_off=0"
 CONFIG_CMDLINE_FORCE=y
 
 # Stage 3 userspace is built in too; kernel/initramfs/ in tb323fu-linux shows
-- 
