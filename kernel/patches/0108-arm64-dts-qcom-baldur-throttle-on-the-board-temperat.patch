From d6d800588caa595bfbbf1c69d5016b2ac7c2ff8b Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Wed, 30 Sep 2026 10:34:25 +0000
Subject: [PATCH 108/111] arm64: dts: qcom: baldur: throttle on the board
 temperature like Android

baldur-thermal.dtsi only protects the silicon: a 95 C passive trip per CPU
zone to the cluster cpufreq, and kaanapali.dtsi does 105 C for the GPU. The
15 board NTC zones (skin, quiet, lcm, batt, ...) only had an 80 C hot trip
that throttles nothing, so a long load heated the case unchecked.

Android's default thermal-engine policy (user case 0,
/vendor/etc/thermal-engine_cpu_0.conf and _gpu_0.conf)
throttles on quiet-therm
(PMK8850 AMUX3_GPIO, our quiet-thermal zone): 43/45/47/49 C cap the big
cluster to 2.88/1.75/1.02/0.88 GHz and the little one to 2.0/1.0/0.38/0.38
GHz, 44/46/48/50 C cap the GPU to 902/646/500/222 MHz (Android's 539 MHz is
not a step here), each clearing 2 C lower. Add those as passive trips with
pinned cooling states, polled every second. The 95 C junction protection
stays. Not copied: the LCD backlight cap and the charge-current steps.

Tested on the device:
emul_temp steps 40..50..40 C give exactly the designed cooling states
(cpu0 13/22/27, cpu6 13/20/26/27, GPU 3/6/8/14) and release with the 2 C
hysteresis; a 600 s all-core load held the CPU zones at 93-98 C while
quiet-thermal rose 31.9 -> 44.8 C with the 43 and 44 C steps engaged.
---
 .../boot/dts/qcom/baldur-skin-thermal.dtsi    | 141 ++++++++++++++++++
 .../qcom/kaanapali-lenovo-baldur-display.dts  |   1 +
 2 files changed, 142 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/baldur-skin-thermal.dtsi

diff --git a/arch/arm64/boot/dts/qcom/baldur-skin-thermal.dtsi b/arch/arm64/boot/dts/qcom/baldur-skin-thermal.dtsi
new file mode 100644
index 000000000..3272dbe6b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/baldur-skin-thermal.dtsi
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * TB323FU ("baldur"): board-temperature (skin) throttling after Android's
+ * thermal-engine.
+ *
+ * baldur-thermal.dtsi only protects the silicon (95 C junction, passive, per
+ * CPU zone); kaanapali.dtsi does 105 C for the GPU. Android throttles long
+ * before that, on the board NTC "quiet-therm" (PMK8850 AMUX3_GPIO, our
+ * quiet-thermal): /vendor/etc/thermal-engine_cpu_0.conf and _gpu_0.conf of
+ * the default user case 0:
+ *
+ *   quiet-therm  43 C  45 C  47 C  49 C     (clear 2 C lower)
+ *   cluster 1    2.88  1.75  1.02  0.88 GHz  (cpu6-7, policy6)
+ *   cluster 0    2.00  1.00  0.38  0.38 GHz  (cpu0-5, policy0)
+ *   quiet-therm  44 C  46 C  48 C  50 C
+ *   GPU          902   646   539   222 MHz   (539 is not an OPP here: 500)
+ *
+ * Each step is a passive trip whose cooling map pins the device to one state
+ * (min = max: step_wise clamps its target to the map's range, and the core
+ * applies the deepest target of all instances of a device). States count from
+ * the highest frequency: cpufreq-cpu0 has 28 (0 = 3.6288 GHz), cpufreq-cpu6
+ * 29 including the two disabled boost frequencies (0 = 4.608 GHz,
+ * 2 = 4.3968 GHz), the GPU devfreq 17 (0 = 1200 MHz).
+ *
+ * Not carried over: the LCD backlight cap at lcm 55 C (no backlight cooling
+ * device) and the charging-current steps (thermal-engine_battery_N.conf).
+ * The zone is an ADC channel; poll it every second like thermal-engine does
+ * instead of relying on ADC_TM threshold interrupts.
+ */
+
+&{/thermal-zones/quiet-thermal} {
+	polling-delay = <1000>;
+	polling-delay-passive = <1000>;
+
+	trips {
+		quiet_43: quiet-43 {
+			temperature = <43000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_44: quiet-44 {
+			temperature = <44000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_45: quiet-45 {
+			temperature = <45000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_46: quiet-46 {
+			temperature = <46000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_47: quiet-47 {
+			temperature = <47000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_48: quiet-48 {
+			temperature = <48000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_49: quiet-49 {
+			temperature = <49000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+
+		quiet_50: quiet-50 {
+			temperature = <50000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {	/* cluster 0 -> 1996800 kHz */
+			trip = <&quiet_43>;
+			cooling-device = <&cpu0 13 13>;
+		};
+
+		map1 {	/* cluster 1 -> 2880000 kHz */
+			trip = <&quiet_43>;
+			cooling-device = <&cpu6 13 13>;
+		};
+
+		map2 {	/* GPU -> 902 MHz */
+			trip = <&quiet_44>;
+			cooling-device = <&gpu 3 3>;
+		};
+
+		map3 {	/* cluster 0 -> 998400 kHz */
+			trip = <&quiet_45>;
+			cooling-device = <&cpu0 22 22>;
+		};
+
+		map4 {	/* cluster 1 -> 1747200 kHz */
+			trip = <&quiet_45>;
+			cooling-device = <&cpu6 20 20>;
+		};
+
+		map5 {	/* GPU -> 646 MHz */
+			trip = <&quiet_46>;
+			cooling-device = <&gpu 6 6>;
+		};
+
+		map6 {	/* cluster 0 -> 384000 kHz */
+			trip = <&quiet_47>;
+			cooling-device = <&cpu0 27 27>;
+		};
+
+		map7 {	/* cluster 1 -> 1017600 kHz */
+			trip = <&quiet_47>;
+			cooling-device = <&cpu6 26 26>;
+		};
+
+		map8 {	/* GPU -> 500 MHz */
+			trip = <&quiet_48>;
+			cooling-device = <&gpu 8 8>;
+		};
+
+		map9 {	/* cluster 1 -> 883200 kHz */
+			trip = <&quiet_49>;
+			cooling-device = <&cpu6 27 27>;
+		};
+
+		map10 {	/* GPU -> 222 MHz */
+			trip = <&quiet_50>;
+			cooling-device = <&gpu 14 14>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts b/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts
index a993b1783..0cb46dae1 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-lenovo-baldur-display.dts
@@ -25,6 +25,7 @@
 #include "pmh0101.dtsi"
 #include "baldur-haptics-flash.dtsi"
 #include "baldur-adc.dtsi"
+#include "baldur-skin-thermal.dtsi"
 #include "baldur-camera.dtsi"
 #include "baldur-ledring.dtsi"
 #include "baldur-stats.dtsi"
