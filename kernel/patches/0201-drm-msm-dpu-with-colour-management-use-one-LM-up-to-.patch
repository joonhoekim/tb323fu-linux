From 97942814a74b32a665595ed721ef744335d381b1 Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sat, 7 Nov 2026 16:32:17 +0900
Subject: [PATCH] drm/msm/dpu: with colour management, use one LM up to the
 mixer width

A CRTC that needs DSPPs takes one per LM, and Kaanapali has DSPPs only
on LM 0-3. The 3D merge split at MAX_HDISPLAY_SPLIT gave a 1920 wide
monitor two LMs and two DSPPs; next to the dual-DSI panel that left
none for a second MST monitor, whose reservation failed. Merge two LMs
for such a CRTC only past max_mixer_width.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index deb13530e..30a2a1db3 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1410,6 +1410,7 @@ static struct msm_display_topology dpu_crtc_get_topology(
 	struct drm_display_mode *mode = &crtc_state->adjusted_mode;
 	struct msm_display_topology topology = {0};
 	struct drm_encoder *drm_enc;
+	bool needs_dspp;
 
 	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask)
 		dpu_encoder_update_topology(drm_enc, &topology, crtc_state->state,
@@ -1439,20 +1440,28 @@ static struct msm_display_topology dpu_crtc_get_topology(
 	 * (mode->hdisplay > MAX_HDISPLAY_SPLIT) check.
 	 */
 
+	needs_dspp = crtc_state->ctm || crtc_state->gamma_lut ||
+		     dpu_crtc_needs_spr(crtc_state) ||
+		     (!drm_atomic_crtc_needs_modeset(crtc_state) &&
+		      to_dpu_crtc_state(crtc_state)->mixers[0].hw_dspp);
+
+	/*
+	 * Each LM of the pair needs its own DSPP, and DSPPs are scarcer than
+	 * LMs: with colour management, merge two LMs only past one LM's width.
+	 */
 	if (topology.num_intf == 2 && !topology.cwb_enabled)
 		topology.num_lm = 2;
 	else if (topology.num_dsc == 2)
 		topology.num_lm = 2;
 	else if (dpu_kms->catalog->caps->has_3d_merge &&
 		 topology.num_dsc == 0)
-		topology.num_lm = (mode->hdisplay > MAX_HDISPLAY_SPLIT) ? 2 : 1;
+		topology.num_lm = (mode->hdisplay > (needs_dspp ?
+				   dpu_kms->catalog->caps->max_mixer_width :
+				   MAX_HDISPLAY_SPLIT)) ? 2 : 1;
 	else
 		topology.num_lm = 1;
 
-	if (crtc_state->ctm || crtc_state->gamma_lut ||
-	    dpu_crtc_needs_spr(crtc_state) ||
-	    (!drm_atomic_crtc_needs_modeset(crtc_state) &&
-	     to_dpu_crtc_state(crtc_state)->mixers[0].hw_dspp))
+	if (needs_dspp)
 		topology.num_dspp = topology.num_lm;
 
 	return topology;
-- 
