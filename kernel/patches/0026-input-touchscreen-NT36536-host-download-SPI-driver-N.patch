From dd06781d8806b8c4dbea5eec9768356de40f3f07 Mon Sep 17 00:00:00 2001
From: joonhoekim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 01:27:24 +0000
Subject: [PATCH 26/56] input: touchscreen: NT36536 host-download SPI driver
 (Novatek)

For y705-mainline-plan.md 9-26. The driver itself is not carried here; take
drivers/input/touchscreen/nt36536/ from map220v/sm8850-mainline, branch
iceland-7.2 (Novatek's GPLv2 driver, already for 7.2, panel follower):

  for f in nt36xxx.c nt36xxx.h nt36xxx_fw_update.c nt36xxx_mem_map.h Kconfig Makefile; do
    gh api "repos/map220v/sm8850-mainline/contents/drivers/input/touchscreen/nt36536/$f?ref=iceland-7.2" \
      -H "Accept: application/vnd.github.raw" > drivers/input/touchscreen/nt36536/$f
  done

then apply the hookup below (the nt36523 line is the earlier nabu attempt,
mainline/touch/port-nabu-nt36xxx.py, left disabled) and set
CONFIG_TOUCHSCREEN_NT36536_SPI=m.

[y705 rebase 7.3: hookup re-done by hand: community synaptics context absent in 7.3; the disabled nt36523 (nabu) source line left out]
y705-source: 0008-input-nt36536-hookup.patch
---
 drivers/input/touchscreen/Kconfig  | 2 ++
 drivers/input/touchscreen/Makefile | 1 +
 2 files changed, 3 insertions(+)

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..c68702b84 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1414,4 +1414,6 @@ config TOUCHSCREEN_HIMAX_HX83112B
 	  To compile this driver as a module, choose M here: the
 	  module will be called himax_hx83112b.
 
+source "drivers/input/touchscreen/nt36536/Kconfig"
+
 endif
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index bfd9de833..538d9810b 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -119,3 +119,4 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
 obj-$(CONFIG_TOUCHSCREEN_IQS7211)	+= iqs7211.o
 obj-$(CONFIG_TOUCHSCREEN_ZINITIX)	+= zinitix.o
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
+obj-$(CONFIG_TOUCHSCREEN_NT36536_SPI)	+= nt36536/
-- 
