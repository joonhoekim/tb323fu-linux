From 9c6ccd8cdd87d3b82a66be6c2c3afe2da8a55378 Mon Sep 17 00:00:00 2001
From: li-yiyang <yiyang.li.11pro@outlook.com>
Date: Mon, 23 Nov 2026 11:20:53 +0800
Subject: [PATCH 3/4] arm64: dts: qcom: baldur: run the microSD slot at 202 MHz

The slot has the BH201 retimer, so declare it and let the host run SDR104
at 202 MHz; the driver calibrates the retimer phase before the root is
mounted.  Without that calibration the slot has to stay at 100 MHz (SDR50,
the retimer's 100m DLL), where it is stable but half as fast.

Signed-off-by: li-yiyang <yiyang.li.11pro@outlook.com>
---
 arch/arm64/boot/dts/qcom/baldur-storage.dtsi | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
index b95a2068a..2cd8ee941 100644
--- a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
+++ b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
@@ -43,6 +43,9 @@ &sdhc_2 {
 	vmmc-supply = <&vreg_l9b_2p9>;
 	vqmmc-supply = <&vreg_l8b_1p8>;
 
+	/* O2Micro/BayHub BH201 retimer between the SoC and the card slot. */
+	lenovo,bh201-retimer;
+
 	cd-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
 	bus-width = <4>;
 	no-sdio;
@@ -55,8 +58,14 @@ &sdhc_2 {
 	/* the card needs about 45 ms between power-on and CMD8 */
 	post-power-on-delay-ms = <100>;
 
-	/* CRC errors at 202 MHz until the BH201 retimer is calibrated */
-	max-frequency = <100000000>;
+	/*
+	 * SDR104 at 202 MHz.  The BH201's 200 MHz TX phase is per card and
+	 * power-up, so the host has to calibrate it before using SDR104; without
+	 * that, host tuning passes but every data read fails with a CRC error.
+	 * The host's own tuning runs first because sdhci-msm enables its
+	 * clock-data-recovery from there.
+	 */
+	max-frequency = <202000000>;
 
 	status = "okay";
 };
-- 
