From e1ead14a6db9a8828b5b48fb8ab40905886ba86a Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Mon, 23 Nov 2026 22:11:10 +0900
Subject: [PATCH] arm64: dts: qcom: baldur: limit the microSD slot to 100 MHz

At SDR104's 202 MHz some cards in this slot get data CRC errors: on some
units reads of the partition table fail at power-up, and a card that does
attach can keep failing reads until ext4 reports I/O errors. The same cards
work without errors at 100 MHz. The slot has a BayHub BH201 retimer whose
200 MHz phase is left at its default, which is the likely cause.

Cap the slot at 100 MHz until the retimer is calibrated.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 arch/arm64/boot/dts/qcom/baldur-storage.dtsi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
index e6372881ccce..b95a2068a01f 100644
--- a/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
+++ b/arch/arm64/boot/dts/qcom/baldur-storage.dtsi
@@ -55,6 +55,9 @@ &sdhc_2 {
 	/* the card needs about 45 ms between power-on and CMD8 */
 	post-power-on-delay-ms = <100>;
 
+	/* CRC errors at 202 MHz until the BH201 retimer is calibrated */
+	max-frequency = <100000000>;
+
 	status = "okay";
 };
 
