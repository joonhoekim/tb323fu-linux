From 5e2750e47dfbdd4be964c92a979eb65433ba746b Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 01:27:40 +0000
Subject: [PATCH 30/56] Bluetooth: qca: WCN7860 (BRAHMA) on the WCN7850 flow

From infiniti-mainline/linux fecd7925d
(EYC, OnePlus 15), placed by hand on this tree (two hunks did not apply):
the WCN6750 patch-config prelude for QCA_WCN7850, an ELF (.mbn) rampatch
from DT, the drain before the final ELF segment, and the peripheral
subsystem baud command (0xfff1) -- this ROM ignores the WCN7850 baud VSC.

On TB323FU with this chip's own firmware (/vendor/bt_firmware/image):
"QCA FW build version: BTFW.BRAHMA.2.0.1-00238 ... QCA setup on UART is
completed" at 3.2 Mbps. The TLV rampatch from the same partition times out
on its first segment with the stock flow.
---
 drivers/bluetooth/btqca.c   | 22 ++++++++++--
 drivers/bluetooth/hci_qca.c | 67 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 86 insertions(+), 3 deletions(-)

diff --git a/drivers/bluetooth/btqca.c b/drivers/bluetooth/btqca.c
index 22b08ab05..64ecf052e 100644
--- a/drivers/bluetooth/btqca.c
+++ b/drivers/bluetooth/btqca.c
@@ -608,8 +608,18 @@ static int qca_download_firmware(struct hci_dev *hdev,
 
 		remain -= segsize;
 		/* The last segment is always acked regardless download mode */
-		if (!remain || segsize < MAX_SIZE_PER_TLV_SEGMENT)
+		if (!remain || segsize < MAX_SIZE_PER_TLV_SEGMENT) {
+			/* The unacked segments bypass the cmd queue and sit in
+			 * the serdev buffer: let it drain before the acked last
+			 * segment, or the HCI command timeout expires first.
+			 */
+			if (config->type == ELF_TYPE_PATCH &&
+			    soc_type == QCA_WCN7850)
+				msleep(config->user_baud_rate ==
+				       QCA_BAUDRATE_115200 ? 28000 : 1200);
+
 			config->dnld_mode = QCA_SKIP_EVT_NONE;
+		}
 
 		ret = qca_tlv_send_segment(hdev, segsize, segment,
 					   config->dnld_mode, soc_type);
@@ -775,13 +785,21 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 	else
 		rom_ver = ((soc_ver & 0x00000f00) >> 0x04) | (soc_ver & 0x0000000f);
 
-	if (soc_type == QCA_WCN6750)
+	/* WCN7860 (BRAHMA) rides QCA_WCN7850 here and needs WCN6750's
+	 * patch-config prelude
+	 */
+	if (soc_type == QCA_WCN6750 || soc_type == QCA_WCN7850)
 		qca_send_patch_config_cmd(hdev);
 
 	/* Download rampatch file */
 	config.type = TLV_TYPE_PATCH;
 	if (rampatch_name) {
+		size_t rlen = strlen(rampatch_name);
+
 		snprintf(config.fwname, sizeof(config.fwname), "qca/%s", rampatch_name);
+		/* a DT-supplied .mbn rampatch is an ELF patch */
+		if (rlen > 4 && !strcmp(rampatch_name + rlen - 4, ".mbn"))
+			config.type = ELF_TYPE_PATCH;
 	} else {
 		switch (soc_type) {
 		case QCA_QCA2066:
diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 7089e9b63..e317a5ba2 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -1401,6 +1401,52 @@ static inline void host_set_baudrate(struct hci_uart *hu, unsigned int speed)
 		hci_uart_set_baudrate(hu, speed);
 }
 
+/* On BRAHMA the shared UART's baud belongs to the peripheral subsystem:
+ * the BT baud VSC (0xfc48) is ignored. The vendor stack switches the rate
+ * with a peri-subsystem command:
+ *
+ *   0x31  HCI_PERI_COMMAND_PKT
+ *   0x00  BT host id
+ *   0xf1 0xff  vendor "general" opcode 0xfff1 (le16)
+ *   0x02  parameter length
+ *   0x02  HCI_PERI_SET_BAUDRATE
+ *   <n>   baud enum, the same table as the BT VSC (8 Mbps is 0x15)
+ *
+ * Fire-and-forget like the BT VSC.
+ */
+static int qca_peri_set_baudrate(struct hci_uart *hu, u8 baudrate)
+{
+	struct qca_data *qca = hu->priv;
+	struct sk_buff *skb;
+	u8 cmd[] = { 0x31, 0x00, 0xF1, 0xFF, 0x02, 0x02, 0x00 };
+
+	cmd[6] = baudrate;
+
+	if (!hu->serdev)
+		return -ENODEV;
+
+	/* safe with host IBS unarmed: the controller ACKs WAKE_IND anyway */
+	if (send_hci_ibs_cmd(HCI_IBS_WAKE_IND, hu) < 0)
+		return -EBUSY;
+
+	msleep(10);
+
+	skb = bt_skb_alloc(sizeof(cmd), GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	skb_put_data(skb, cmd, sizeof(cmd));
+	skb_queue_tail(&qca->txq, skb);
+	hci_uart_tx_wakeup(hu);
+
+	/* No completion event to wait on — give the queue and the peri
+	 * subsystem time to apply the switch before the host follows.
+	 */
+	msleep(100);
+
+	return 0;
+}
+
 static int qca_send_power_pulse(struct hci_uart *hu, bool on)
 {
 	int timeout = CMD_TRANS_TIMEOUT;
@@ -2000,6 +2046,19 @@ static int qca_setup(struct hci_uart *hu)
 		qca_set_speed(hu, QCA_INIT_SPEED);
 	}
 
+	/* This ROM ignores the BT baud VSC the user-speed switch below
+	 * sends: move the UART with the peri command first.
+	 */
+	if (soc_type == QCA_WCN7850) {
+		speed = qca_get_speed(hu, QCA_OPER_SPEED);
+		if (speed) {
+			ret = qca_peri_set_baudrate(hu,
+					qca_get_baudrate_value(speed));
+			if (ret)
+				goto out;
+		}
+	}
+
 	/* Setup user speed if needed */
 	speed = qca_get_speed(hu, QCA_OPER_SPEED);
 	if (speed) {
@@ -2032,7 +2091,13 @@ static int qca_setup(struct hci_uart *hu)
 	ret = qca_uart_setup(hdev, qca_baudrate, soc_type, ver,
 			firmware_name, rampatch_name);
 	if (!ret) {
-		clear_bit(QCA_IBS_DISABLED, &qca->flags);
+		/* At init speed this ROM stops answering after an IBS
+		 * sleep/wake cycle: arm IBS only once the peri command has
+		 * moved the UART to the operating rate.
+		 */
+		if (soc_type != QCA_WCN7850 ||
+		    qca_baudrate != QCA_BAUDRATE_115200)
+			clear_bit(QCA_IBS_DISABLED, &qca->flags);
 		qca_debugfs_init(hdev);
 		hu->hdev->hw_error = qca_hw_error;
 		hu->hdev->reset = qca_reset;
-- 
