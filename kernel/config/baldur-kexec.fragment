# SPDX-License-Identifier: GPL-2.0-only
# 9-13: the same test kernel, started by kexec from Android instead of by the
# bootloader. Merge after baldur.fragment.
#
# - its own devicetree: the board tree plus the four CMA regions Android may
#   have lent out (kaanapali-lenovo-baldur-kexec.dts)
# - download mode off: boot_a still holds Android, so a panic should warm-reset
#   back into Android (ramoops intact), not into the crash dump mode
# - baldur.end=reboot: /init restarts in order after its countdown, whatever the
#   download mode -- an orderly restart is a warm reset (see init)
# - irqchip.gicv3_nolpi=1: leave the GIC's LPIs alone. Android runs them (the
#   UFS interrupts are ITS MSIs) and they cannot be switched off, so the
#   redistributors keep Android's tables; nothing reserves those across kexec
#   (Linux only does that through EFI), and a new kernel that "reuses" them
#   writes the default LPI config (0xc2 bytes) over whatever is there now. In
#   QEMU that was its own kernel text (y705-mainline-plan.md 9-13)
# - reboot=warm: ask PSCI for SYSTEM_RESET2 warm. Tried against ramoops' bit
#   flips, which turned out to be the device's own (9-15); harmless, kept
# - baldur.wait=20: a short countdown for the kexec loop
CONFIG_ARM64_BUILTIN_FDT_NAME="qcom/kaanapali-lenovo-baldur-kexec.dtb"
CONFIG_CMDLINE="icc-rpmh.qos_disable=1 icc_rpmh.qos_disable=1 clk_ignore_unused pd_ignore_unused initcall_blacklist=clk_disable_unused,genpd_power_off_unused,regulator_init_complete,of_platform_sync_state_init fw_devlink=off initcall_debug loglevel=8 fbcon=font:TER16x32 panic=10 oops=panic console=tty1 keep_bootcon qcom_scm.download_mode=off baldur.end=reboot irqchip.gicv3_nolpi=1 reboot=warm baldur.wait=20"
