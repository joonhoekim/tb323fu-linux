# SPDX-License-Identifier: MIT
[Unit]
Description=Start the audio and compute DSPs once their firmware is reachable
# qcom_q6v5_pas probes from the initramfs, before the root filesystem with
# /lib/firmware/qcom/kaanapali/lenovo/baldur/{adsp,cdsp}.mbn (too big for the
# boot image) is mounted, so its auto-boot finds no firmware and gives up.
# Start them here instead; a DSP that is already running is left alone.
DefaultDependencies=no
After=local-fs.target
Before=sound.target
ConditionPathExists=/lib/firmware/qcom/kaanapali/lenovo/baldur/adsp.mbn

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tb323fu/tb323fu-dsp

[Install]
WantedBy=sysinit.target
