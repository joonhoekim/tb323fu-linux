# SPDX-License-Identifier: MIT
[Unit]
Description=Build the sensor hub's files from this tablet's Android partitions (once)
# hexagonrpcd's drop-in pulls this in. The files are the device's own (factory
# calibration in the registry) and are never shipped in an image.
After=local-fs.target
Before=hexagonrpcd.service
ConditionPathExists=!/var/lib/tb323fu/sensors

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tb323fu/tb323fu-sensors-tree
