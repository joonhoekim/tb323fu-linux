# the tablet's documented USB-gadget network (device side .2, host side .1)
^ip\|.*192\.168\.7\.[12]([^0-9]|$)
# the dev-password variable referenced by name only (never a value)
^password\|[^|]*:[0-9]+:.*(\$\{?BALDUR_DEV_PASSWORD|BALDUR_DEV_PASSWORD=( |\$|\.\.\.))
# the hook that sets the user's password from install.sh's USER_PASSWORD (a variable, never a value)
^password\|[^|]*:[0-9]+:.*distro_chpasswd
# the allowlist itself names the variable in its rules
^password\|\.public-scan\.allow:
# the initramfs USB gadget: fixed locally administered NCM MACs and a made-up serial (same on every install)
^mac\|(\./)?kernel/initramfs/init:[0-9]+:.*02:ba:1d:00:00:0[12]
^serial\|(\./)?kernel/initramfs/init:[0-9]+:.*"baldur-0001"
# a battmgr struct field name in patch context (not a device identifier)
^serial\|kernel/patches/[^:]*:[0-9]+:.*char s.rial_number\[BATTMGR_STRING_LEN\];
