# the tablet's documented USB-gadget network (device side .2, host side .1)
^ip\|.*192\.168\.7\.[12]([^0-9]|$)
# kernel patches carry authors' and mailing-list addresses in headers and trailers
^email\|[^|]*:[0-9]+:.*(Signed-off-by|Reviewed-by|Acked-by|Tested-by|Reported-by|Co-developed-by|Suggested-by|Cc|To|From|Author):
^email\|[^|]*\.patch:
^email\|[^|]*@(vger\.kernel\.org|lists\.linux\.dev|lists\.freedesktop\.org|kernel\.org|linaro\.org|oss\.qualcomm\.com|quicinc\.com)
# GNOME Shell extension UUIDs look like e-mail addresses
^email\|[^|]*:[0-9]+:.*extensions/[A-Za-z0-9._-]+@[A-Za-z0-9._-]+/
# this repository's GNOME Shell extension UUID
^email\|[^|]*:[0-9]+:.*tb323fu@joonhoekim\.github\.io
# package maintainer field (the author's public address, same as in commits)
^email\|packaging/[^|]*:[0-9]+:MAINT=
